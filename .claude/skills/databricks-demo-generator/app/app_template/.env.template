DATABRICKS_HOST=

# --- Lakebase (auto-injected in prod; required for local dev) ---
#
# LAKEBASE_ENDPOINT and PGHOST are TWO DIFFERENT values. Do NOT put the same
# thing in both. Source them from:
#   databricks postgres get-endpoint projects/<PROJECT_ID>/branches/production/endpoints/primary
#
# LAKEBASE_ENDPOINT = the resource name (a path, NOT a hostname).
#   Format: projects/<PROJECT_ID>/branches/production/endpoints/primary
#   Used by: AppKit's Lakebase OAuth token refresh (@databricks/lakebase).
#   Example: projects/0e3a1f7f-.../branches/production/endpoints/primary
#
# PGHOST = the DNS hostname of the Postgres endpoint.
#   Format: <endpoint-id>.database.<region>.cloud.databricks.com
#   Used by: psycopg / node-postgres to open the TCP connection.
#   Found under .status.hosts.host in the get-endpoint response.
#   Example: ep-small-dawn-d13fr9rm.database.us-west-2.cloud.databricks.com
#
LAKEBASE_ENDPOINT=
PGHOST=
PGDATABASE=databricks_postgres
PGSSLMODE=require
PGPORT=5432

# --- Workspace + warehouse ---
DATABRICKS_WORKSPACE_ID=
DATABRICKS_WAREHOUSE_ID=
