# Skip lifecycle scripts during `npm install` on the Databricks Apps
# container. Postinstall is `npm run typegen` (calls `appkit
# generate-types`) which needs source-build context the runtime
# container doesn't have.
ignore-scripts=true

# Production-only install on the App container — only runtime deps are
# needed because dist/server.js is shipped pre-built by scripts/build-app.sh.
# Locally, `npm install --include=dev` overrides this so the build
# tooling (tsdown, vite, etc.) is available for the build step.
omit=dev

# NOTE: registry override intentionally NOT set here. Local installs
# use whichever registry the developer's ~/.npmrc points at. The
# scripts/strip-internal-registry.sh step rewrites lockfile URLs to
# the public registry so the App container (which can't reach the
# Databricks internal proxy) succeeds.
