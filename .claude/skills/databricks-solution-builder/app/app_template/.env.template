# ─────────────────────────────────────────────────────────────────────────
# .env — runtime config for LOCAL DEV and PREVIEW mode (copy to `.env`).
#
# How env reaches the app in each of the 3 run modes:
#   • Deployed Databricks App → the platform injects everything from
#     databricks.yml bindings + app.yaml (this file is NOT used).
#   • Local dev (./start.sh)  → start.sh `source`s this `.env`.
#   • Preview (in generator)  → the generator's preview runner spawns
#     start.sh, which `source`s this `.env`. (The runner only overlays
#     auth + DATABRICKS_APP_PORT on top; the demo values come from here.)
#
# So for local + preview, THIS FILE is the single source of the demo's
# runtime values. Every ${VAR} placeholder in config/app.json reads from
# here (server.ts substitutes process.env at boot). Fill them in.
# ─────────────────────────────────────────────────────────────────────────

DATABRICKS_HOST=

# --- Workspace + warehouse ---
DATABRICKS_WORKSPACE_ID=
# AppKit's analytics + the charts route read DATABRICKS_WAREHOUSE_ID; the
# /platform deep-link tile reads WAREHOUSE_ID. Same value — set both.
DATABRICKS_WAREHOUSE_ID=
WAREHOUSE_ID=

# --- Data (Unity Catalog) — set these for a working local/preview run ---
# Catalog + schema holding the demo's Delta tables (silver_returns, etc.).
# Substituted into config/app.json (data.catalog/schema, mlModelName,
# pdfVolumePath) and used by server/routes/charts.ts as the SQL session
# context. If unset the app still BOOTS, but /analytics + the Delta→Lakebase
# sync are skipped (degraded). Set them to light up the data features.
DEMO_CATALOG=
DEMO_SCHEMA=

# --- Resource deep-links + agent wiring (optional; empty → inert) ---
# Light up the /platform tiles + the agent's data tool. Empty → inert tile /
# disabled tool; the app still runs. Fill from the setup job's
# export_resources output (or resources.json) once those resources exist.
DASHBOARD_ID=
PIPELINE_ID=
GENIE_SPACE_ID=
KA_ENDPOINT_NAME=
MAS_ENDPOINT_NAME=
# MLflow trace path for the agent. Empty → "Trace pending…" but app runs.
AGENT_MLFLOW_EXPERIMENT_PATH=
# This app's own deployed URL (deep-link self-reference). Empty in local/preview.
APP_URL=

# --- App ---
# Used by scripts/deploy.sh as the workspace App name + the upload dir.
APP_NAME=

# --- Lakebase ---
# Read by AppKit's lakebase plugin for local dev AND when deployed via
# `databricks apps deploy` (no DAB) — `.env` ships with the source. When
# the user later packages the demo as a DAB, the postgres binding auto-
# injects PG* and `valueFrom: postgres` supplies LAKEBASE_ENDPOINT
# (.env is unused at runtime in that case).
#
# Values come from scripts/lakebase_setup_db.sh's printed output.
#
# Two flavors of the same identifiers:
#   - LAKEBASE_BRANCH / LAKEBASE_DATABASE   = full resource PATHS (start with `projects/`).
#     Passed to lakebase() plugin config so AppKit can resolve permissions + bundle bindings.
#   - PGHOST / PGDATABASE                   = connection-string values for `pg.Pool`.
#     PGHOST is a DNS name; PGDATABASE is the short database name. Don't swap them.
LAKEBASE_PROJECT_ID=
LAKEBASE_ENDPOINT=
LAKEBASE_BRANCH=
LAKEBASE_DATABASE=
PGHOST=
PGDATABASE=
PGPORT=5432
PGSSLMODE=require
