// =============================================================================
// AGENT BRICKS — a multi-agent "Agent Bricks" architecture over a governed
// medallion + a document Knowledge Assistant.
//
// JSONC (JSON + // comments) for YOU to read. Emit PLAIN JSON (strip //) in the
// architecture.md ```json fence.
//
// WHAT IT SHOWS:
//   • rowGrid layout — `row` aligns across ALL lanes into shared bands:
//       row 1              Hosted MCPs
//       row 2              Genie Agent          Supervisor Agent
//       row 3   Postgres · Medallion · AI/BI Dashboard
//       row 4   PDF docs ·            Knowledge Assistant
//     so PDF (row 4) lines up with the Knowledge Assistant it feeds, and
//     Postgres (row 3) lines up with the medallion — clean horizontal feeds.
//   • A governed medallion (`medallion-table`, params.metric_views on) forks a
//     Metric Views layer off GOLD and exposes `@out-gold` + `@out-mv`:
//       – Genie Agent reads GOLD (`@out-gold` → genie).
//       – the AI/BI Dashboard reads the METRIC VIEWS (`@out-mv` → dashboard).
//   • PDF documents feed the Knowledge Assistant DIRECTLY (unstructured RAG),
//     NOT through the medallion.
//   • A Supervisor Agent orchestrates the three tools (Knowledge Assistant ·
//     Genie Agent · Hosted MCPs) and serves business users through Genie One.
//
// AUTHOR STRUCTURE, NOT PIXELS. See the medallion catalog row for the
// `@out-gold` / `@out-mv` / `@l` handles.
// =============================================================================
[
  {
    "name": "Agent Bricks",
    "story": "Ingest our Postgres data into a governed medallion (bronze→silver→gold) with a Metric Views layer; a Genie Agent queries the gold tables and an AI/BI dashboard reads the governed metric views. Separately, our PDF documents feed a Knowledge Assistant for grounded Q&A. A Supervisor Agent orchestrates the Knowledge Assistant, Genie Agent, and hosted MCP tools, and serves answers to business users through Genie One.",
    "columns": ["sources", "pipeline", "tools", "supervisor", "entry"],
    "rowGrid": true,
    "nodes": [
      { "id": "src-postgres", "type": "source", "col": "sources", "row": 3, "label": "Postgres", "icon": "file:vendor/postgresql" },
      { "id": "src-pdf", "type": "source", "col": "sources", "row": 4, "label": "PDF documents", "icon": "pdfLogo",
        "note": "PDFs feed the Knowledge Assistant DIRECTLY (unstructured RAG) — NOT through the medallion. Placed on row 4 to line up with the Knowledge Assistant." },

      { "id": "medallion-table", "type": "medallion-table", "col": "pipeline", "row": 3, "params": { "metric_views": true },
        "note": "params.metric_views on → a Metric Views fork off GOLD + the `@out-mv` handle (plus the always-present `@out-gold`). Genie reads gold, the dashboard reads metric views." },

      { "id": "hosted-mcps", "type": "hosted-mcps", "col": "tools", "row": 1,
        "note": "The three `tools` (rows 1-3, this + genie + knowledge-assistant) each fan INTO the Supervisor on the right — it routes a question to whichever tool answers it. Hosted MCPs = the agent's external-tool reach." },
      { "id": "genie", "type": "genie", "col": "tools", "row": 2 },
      { "id": "ai-bi-dashboard", "type": "ai-bi-dashboard", "col": "tools", "row": 3,
        "note": "Sits in the `tools` lane on row 3 (aligned with the medallion it reads) but is NOT a Supervisor tool — it's a consumption surface fed by the metric views, wired straight to Genie One." },
      { "id": "knowledge-assistant", "type": "knowledge-assistant", "col": "tools", "row": 4,
        "note": "Row 4 to line up with the PDF source that feeds it. Managed RAG over the docs (no separate Vector Search node needed — KA handles chunk/index/retrieve)." },

      { "id": "supervisor-agent", "type": "supervisor-agent", "col": "supervisor", "row": 2,
        "note": "Row 2 = centered against the tool stack it fans in from, so the three `@l` inbound edges stay balanced." },

      { "id": "genie-one", "type": "genie-one", "col": "entry", "row": 2, "rot": 90,
        "note": "Business-user entry point — the persona pill is built INTO the tile (no separate user node). Rotated 90° into a slim right-hand lane. Its inbound edges (from Supervisor + Dashboard) auto-arrow — leave `arrow`/`flow` off." },

      // The Databricks Platform box wraps EVERYTHING EXCEPT the data sources —
      // the sources sit OUTSIDE (they're external systems feeding the platform).
      // db-platform is the wordmark banner pinned to the box's top-left corner
      // (renders with no border/shadow by default).
      { "id": "db-platform", "type": "db-platform", "pin": { "at": "top-left", "to": "platform-box" },
        "desc": "The Databricks Data + AI platform — one governed foundation for all data + AI." },
      { "id": "platform-box", "type": "box", "z": -1, "pad": 40,
        "wraps": ["medallion-table", "hosted-mcps", "genie", "ai-bi-dashboard", "knowledge-assistant", "supervisor-agent", "genie-one"],
        "note": "Wraps all on-platform components; the two data SOURCES are intentionally left out so they read as external systems feeding in. z:-1 so it sits behind the tiles." }
    ],
    "edges": [
      { "id": "e-pg-med", "from": "src-postgres@r", "to": "medallion-table@l", "flow": true },
      { "id": "e-pdf-ka", "from": "src-pdf@r", "to": "knowledge-assistant@l", "flow": true, "label": "Split and index documents",
        "note": "Label describes what KA does to the docs on the way in (chunk → embed → index). The `docs` travelling-glyph animation is auto-picked because the source is a PDF." },

      { "id": "e-med-genie", "from": "medallion-table@out-gold", "to": "genie@l", "flow": true, "label": "Query gold",
        "note": "Genie reads the GOLD tables directly — `@out-gold` handle." },
      { "id": "e-med-dash", "from": "medallion-table@out-mv", "to": "ai-bi-dashboard@l", "flow": true, "label": "Aggregations",
        "note": "Dashboard reads the METRIC VIEWS fork — `@out-mv` handle. 'Aggregations' = the governed aggregate metrics the metric-views layer exposes." },

      { "id": "e-ka-sup", "from": "knowledge-assistant@r", "to": "supervisor-agent@l", "flow": true },
      { "id": "e-genie-sup", "from": "genie@r", "to": "supervisor-agent@l", "flow": true },
      { "id": "e-mcp-sup", "from": "hosted-mcps@r", "to": "supervisor-agent@l", "flow": true },

      { "id": "e-sup-genieone", "from": "supervisor-agent@r", "to": "genie-one@l" },
      { "id": "e-dash-genieone", "from": "ai-bi-dashboard@r", "to": "genie-one@l" }
    ]
  }
]
