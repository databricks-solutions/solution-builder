// =============================================================================
// COMPLETE reference architecture — the canonical "end-to-end platform" shape.
//
// This is JSONC (JSON + // comments) for YOU, the agent, to read and understand
// the layout. When you write the project's `architecture.md`, emit PLAIN JSON
// (no comments) inside a ```json fence — strip these comments.
//
// AUTHOR STRUCTURE, NOT PIXELS. The renderer computes coordinates from:
//   • `columns`: ordered left→right lanes. Each node names its lane via `col`
//     (and optional `row` to order within the lane). Nodes in a lane stack
//     vertically, centered. You do NOT write x/y for laned nodes.
//   • `wraps`: a `type:"box"` node lists the ids it should ENCLOSE; the box
//     auto-sizes around them (+ `pad`). Use it for the platform box, or for
//     cloud/VPC/zone containers (nesting works: a box may wrap other boxes).
//   • Edges: write `from`/`to` by node id — the `@handle` is INFERRED from
//     geometry (left→right ⇒ source @r → target @l) and, for a source feeding
//     the Lakeflow block, from the source's `ingest` (→ the right in-* port).
//     Add an explicit `@handle` only to override (e.g. `@b`/`@t` for a vertical
//     link). An explicit `at` on a node also overrides its column placement —
//     handy for banners (db-platform / governance) that sit outside the flow.
//   The user can drag anything afterwards; their positions persist as `at`.
//
// LEFT → RIGHT story:
//   sources (≈3 rows) → Lakeflow + Genie (one block) → lakehouse + lakebase
//        → dashboard + Genie Room + app → Genie One → the end user
//   db-platform wordmark + governance-block (UC) sit as a top band; one big
//   white `box` wraps the whole flow = "the Databricks Platform".
//
// THE lakeflow-genie-block HAS THREE LEFT PORTS — a source's `ingest` picks one:
//   lakeflow-connect → in-lakeflow-connect  (databases / SaaS: Postgres, SAP…)
//   zerobus          → in-zerobus           (realtime / sensors / events: Kafka)
//   direct           → in-direct            (files: PDF, CSV/Parquet dumps)
//   Right port `@r` → the compute layer. Inside the block = Genie Code + SDP
//   (all bronze→silver→gold) — do NOT add separate sdp / genie-code nodes.
// =============================================================================
{
  "name": "Data Intelligence Platform — End-to-End Architecture",
  "story": "Sources → one governed Lakeflow + Genie pipeline → lakehouse & lakebase → dashboards, Genie and an app → the business user via Genie One.",

  // Lanes, left → right. Add/rename/insert lanes freely for a different shape
  // (e.g. add "ml" between compute and work) — there's no fixed taxonomy.
  "columns": ["sources", "pipeline", "compute", "work", "entry", "user"],

  "nodes": [
    // ≈3 sources, stacked in the "sources" lane. `ingest` routes each to the
    // matching Lakeflow port (no @handle needed on the edge).
    { "id": "src-erp",      "type": "source", "col": "sources", "row": 1, "label": "ERP System",  "icon": "file:vendor/sap",        "ingest": "lakeflow-connect" },
    { "id": "src-postgres", "type": "source", "col": "sources", "row": 2, "label": "Postgres",    "icon": "file:vendor/postgresql", "ingest": "lakeflow-connect" },
    { "id": "src-sensors",  "type": "source", "col": "sources", "row": 3, "label": "Sensor data", "icon": "sensorSource",           "ingest": "zerobus" },

    // The ONE processing block (ingest + bronze→silver→gold, built by Genie Code).
    { "id": "lakeflow-genie-block", "type": "lakeflow-genie-block", "col": "pipeline", "desc": "Declarative bronze → silver → gold pipeline — Genie Code describes the transformations, Lakeflow runs them reliably at scale." },

    // Compute lane — both fed by the block.
    { "id": "lakehouse", "type": "lakehouse", "col": "compute", "row": 1, "desc": "One governed copy of the data for BI + AI — real-time queries at scale." },
    { "id": "lakebase",  "type": "lakebase",  "col": "compute", "row": 2, "desc": "Serverless Postgres for live app state — reads/writes the app's queue." },

    // Work lane — analytics + the app.
    { "id": "aibi-dashboards",     "type": "aibi-dashboards",     "col": "work", "row": 1, "desc": "Executive KPI dashboard — live from the lakehouse." },
    { "id": "genie",               "type": "genie",               "col": "work", "row": 2, "desc": "Business users ask questions in plain language — governed, auditable answers." },
    { "id": "databricks-apps-work","type": "databricks-apps-work","col": "work", "row": 3 },

    // Business-user entry point (rotated to stand vertically), then the user.
    { "id": "genie-one", "type": "genie-one", "col": "entry", "rot": 90 },
    { "id": "user",      "type": "logo",      "col": "user", "icon": "file:persona/user" },

    // Top band — banners placed with explicit `at` (outside the column flow).
    // db-platform + governance-block render with NO border/shadow by default.
    { "id": "db-platform",      "type": "db-platform",      "at": [190, -178],  "desc": "The Databricks Data Intelligence Platform — one governed foundation for all data + AI." },
    { "id": "governance-block", "type": "governance-block", "at": [1058, -178], "desc": "Unity Catalog governs access, lineage and quality across every table — one control plane for data + AI." },

    // The big white "platform" box — auto-sized to WRAP the whole flow (z:-1).
    // (A box shows a 1px border by default; set style.border to change it.)
    { "id": "platform-box", "type": "box", "z": -1, "pad": 40,
      "wraps": ["src-erp", "src-postgres", "src-sensors", "lakeflow-genie-block", "lakehouse", "lakebase", "aibi-dashboards", "genie", "databricks-apps-work", "genie-one", "user"] }
  ],

  "edges": [
    // sources → Lakeflow (port inferred from each source's ingest)
    { "id": "e1", "from": "src-erp",      "to": "lakeflow-genie-block", "flow": true },
    { "id": "e2", "from": "src-postgres", "to": "lakeflow-genie-block", "flow": true },
    { "id": "e3", "from": "src-sensors",  "to": "lakeflow-genie-block", "flow": true },
    // block → compute, compute → consumers (all left→right, handles inferred)
    { "id": "e4", "from": "lakeflow-genie-block", "to": "lakehouse", "flow": true },
    { "id": "e5", "from": "lakeflow-genie-block", "to": "lakebase",  "flow": true },
    { "id": "e6", "from": "lakehouse", "to": "aibi-dashboards", "flow": true },
    { "id": "e7", "from": "lakehouse", "to": "genie",           "flow": true },
    { "id": "e8", "from": "lakebase",  "to": "databricks-apps-work", "flow": true },
    // the app also consumes the dashboard + Genie Room (vertical — force @b/@t)
    { "id": "e9",  "from": "genie@b",           "to": "databricks-apps-work@t" },
    { "id": "e10", "from": "aibi-dashboards@b", "to": "databricks-apps-work@t" },
    // user ==> Genie One; Genie One --> dashboard / Genie Room / app. These are
    // RELATIONSHIP lines — leave `flow`/`arrow` out: the renderer auto-draws the
    // arrowhead (user→GenieOne points IN; GenieOne→resource points OUT).
    { "id": "e11", "from": "user",      "to": "genie-one" },
    { "id": "e12", "from": "genie-one", "to": "genie" },
    { "id": "e13", "from": "genie-one", "to": "aibi-dashboards" },
    { "id": "e14", "from": "genie-one", "to": "databricks-apps-work" }
  ]
}
