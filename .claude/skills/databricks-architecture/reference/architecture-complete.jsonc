// =============================================================================
// COMPLETE reference architecture — the canonical "end-to-end platform" shape.
//
// This is JSONC (JSON + // comments) for YOU, the agent, to read and understand
// the layout. When you write the project's `architecture.md`, emit PLAIN JSON
// (no comments) inside a ```json fence — strip these comments.
//
// AUTHOR STRUCTURE, NOT PIXELS. The renderer computes coordinates from:
//   • `columns`: ordered left→right lanes. Each node names its lane via `col`
//     (and optional `row` to order within the lane). Nodes in a lane stack
//     vertically, centered. You do NOT write x/y for laned nodes.
//   • `wraps`: a `type:"box"` node lists the ids it should ENCLOSE; the box
//     auto-sizes around them (+ `pad`). Use it for the platform box, or for
//     cloud/VPC/zone containers (nesting works: a box may wrap other boxes).
//   • Edges: write `from`/`to` by node id — the `@handle` is INFERRED from
//     geometry (left→right ⇒ source @r → target @l). For a source feeding the
//     Lakeflow block, name the ingest PORT with an explicit target handle
//     (`@in-lakeflow-connect` / `@in-zerobus` / `@in-direct`) — that handle sets
//     both the port anchor AND the flow animation. Add an explicit `@handle`
//     elsewhere only to override (e.g. `@b`/`@t` for a vertical link). Banners
//     (db-platform / governance) use `pin` to dock onto a box's corner — never
//     absolute `at` (which only holds for one node set).
//   The user can drag anything afterwards; their positions persist as `at`.
//
// LEFT → RIGHT story:
//   sources (≈3 rows) → Lakeflow + Genie (one block) → lakehouse + lakebase
//        → dashboard + Genie Room + app → Genie One (business user built in)
//   db-platform wordmark + governance-block (UC) pin to the platform box's
//   top corners; one big white `box` wraps the whole flow = "the Databricks
//   Platform" (the pins reserve a top band so the box encloses them too).
//
// THE lakeflow-genie-block HAS THREE LEFT PORTS — the edge's target handle picks one:
//   @in-lakeflow-connect  (databases / SaaS: Postgres, SAP…)
//   @in-zerobus           (realtime / sensors / events — particle-stream flow)
//   @in-direct            (files: PDF, CSV/Parquet dumps — travelling-docs flow)
//   Right port `@r` → the compute layer. Inside the block = Genie Code + SDP
//   (all bronze→silver→gold) — do NOT add separate sdp / genie-code nodes.
//
// TABS: the top level is a JSON ARRAY — each element is one tab (its `name` is
// the tab label). This file has two: the full end-to-end platform, then a small
// "Serving layer" tab showing the standard single-row compute/serving tiles
// (Lakehouse · Lakebase · Model Serving · Hosted MCPs) that share ONE default
// footprint so a column of them lines up.
// =============================================================================
[
{
  "name": "Data Intelligence Platform — End-to-End Architecture",
  "story": "Sources → one governed Lakeflow + Genie pipeline → lakehouse & lakebase → dashboards, Genie and an app → the business user via Genie One.",

  // Lanes, left → right. Add/rename/insert lanes freely for a different shape
  // (e.g. add "ml" between compute and work) — there's no fixed taxonomy.
  "columns": ["sources", "pipeline", "compute", "work", "entry"],

  "nodes": [
    // ≈3 sources, stacked in the "sources" lane. The edge (below) names the
    // Lakeflow ingest PORT via an explicit `@in-*` target handle.
    { "id": "src-erp",      "type": "source", "col": "sources", "row": 1, "label": "ERP System",  "icon": "file:vendor/sap" },
    { "id": "src-postgres", "type": "source", "col": "sources", "row": 2, "label": "Postgres",    "icon": "file:vendor/postgresql" },
    // A source can position + size its caption; `desc` adds a one-line blurb.
    { "id": "src-sensors",  "type": "source", "col": "sources", "row": 3, "label": "Sensor data", "icon": "sensorSource",           "fontSize": 12, "desc": "Realtime IoT stream" },

    // The ONE processing block (ingest + bronze→silver→gold, built by Genie Code).
    { "id": "lakeflow-genie-block", "type": "lakeflow-genie-block", "col": "pipeline", "desc": "Declarative bronze → silver → gold pipeline — Genie Code describes the transformations, Lakeflow runs them reliably at scale." },

    // Compute lane — both fed by the block.
    { "id": "sql-lakehouse", "type": "sql-lakehouse", "col": "compute", "row": 1, "desc": "One governed copy of the data for BI + AI — real-time queries at scale." },
    { "id": "lakebase",  "type": "lakebase",  "col": "compute", "row": 2, "desc": "Serverless Postgres for live app state — reads/writes the app's queue." },

    // Work lane — analytics + the app.
    { "id": "ai-bi-dashboard",     "type": "ai-bi-dashboard",     "col": "work", "row": 1, "desc": "Executive KPI dashboard — live from the lakehouse." },
    { "id": "genie",               "type": "genie",               "col": "work", "row": 2, "desc": "Business users ask questions in plain language — governed, auditable answers." },
    { "id": "databricks-apps-work","type": "databricks-apps-work","col": "work", "row": 3 },

    // Genie One = the business-user INTERFACE onto everything to its left. It
    // has the "Business users" persona built IN (a pill above the tile) — no
    // separate user node needed. It's a wide banner, so rotate it 90° to stand
    // vertically — a slim lane that saves horizontal space.
    { "id": "genie-one", "type": "genie-one", "col": "entry", "rot": 90 },

    // Top band — banners PINNED to the platform box's corners (never absolute
    // `at`: those coordinates only hold for one node set; change the sources
    // and the banners drift off-corner). A non-float pin also RESERVES a top
    // band — the box grows to enclose the banners, so it reads as the outer
    // frame around governance ("all of this is the platform").
    // db-platform + governance-block render with NO border/shadow by default.
    { "id": "db-platform",      "type": "db-platform",      "pin": { "at": "top-left",  "to": "platform-box" }, "desc": "The Databricks Data Intelligence Platform — one governed foundation for all data + AI." },
    { "id": "governance-block", "type": "governance-block", "pin": { "at": "top-right", "to": "platform-box" }, "desc": "Unity Catalog governs access, lineage and quality across every table — one control plane for data + AI." },

    // The big white "platform" box — auto-sized to WRAP the whole flow (z:-1).
    // (A box shows a 1px border by default; set style.border to change it.)
    { "id": "platform-box", "type": "box", "z": -1, "pad": 40,
      "wraps": ["src-erp", "src-postgres", "src-sensors", "lakeflow-genie-block", "sql-lakehouse", "lakebase", "ai-bi-dashboard", "genie", "databricks-apps-work", "genie-one"] }
  ],

  "edges": [
    // sources → Lakeflow: name the ingest PORT on the target handle (also drives
    // the flow animation: @in-zerobus → particles, @in-direct → docs, else laser)
    { "id": "e1", "from": "src-erp",      "to": "lakeflow-genie-block@in-lakeflow-connect", "flow": true },
    { "id": "e2", "from": "src-postgres", "to": "lakeflow-genie-block@in-lakeflow-connect", "flow": true },
    { "id": "e3", "from": "src-sensors",  "to": "lakeflow-genie-block@in-zerobus", "flow": true },
    // block → compute, compute → consumers (all left→right, handles inferred)
    { "id": "e4", "from": "lakeflow-genie-block", "to": "sql-lakehouse", "flow": true },
    { "id": "e5", "from": "lakeflow-genie-block", "to": "lakebase",  "flow": true },
    { "id": "e6", "from": "sql-lakehouse", "to": "ai-bi-dashboard", "flow": true },
    { "id": "e7", "from": "sql-lakehouse", "to": "genie",           "flow": true },
    { "id": "e8", "from": "lakebase",  "to": "databricks-apps-work", "flow": true },
    // the app also consumes the dashboard + Genie Room (vertical — force @b/@t)
    { "id": "e9",  "from": "genie@b",           "to": "databricks-apps-work@t" },
    { "id": "e10", "from": "ai-bi-dashboard@b", "to": "databricks-apps-work@t" },
    // Genie One (business user built in) --> dashboard / Genie Room / app. These
    // are RELATIONSHIP lines — leave `flow`/`arrow` out: the renderer auto-draws
    // the arrowhead pointing OUT toward each resource.
    { "id": "e12", "from": "genie-one", "to": "genie" },
    { "id": "e13", "from": "genie-one", "to": "ai-bi-dashboard" },
    { "id": "e14", "from": "genie-one", "to": "databricks-apps-work" }
  ]
},
{
  // Second tab — the standard compute / serving tiles. They carry NO explicit
  // `size`; each falls to the shared 230×54 default (see naturalSize), so a
  // single `serving` column lines them up with no hand-tuning.
  "name": "Serving layer",
  "columns": ["serving"],
  "nodes": [
    { "id": "lakehouse",     "type": "lakehouse",     "col": "serving", "row": 1 },
    { "id": "lakebase",      "type": "lakebase",      "col": "serving", "row": 2 },
    { "id": "model-serving", "type": "model-serving", "col": "serving", "row": 3 },
    { "id": "hosted-mcps",   "type": "hosted-mcps",   "col": "serving", "row": 4 },
    // A wrapper box around the four tiles: a `type:"box"` node that `wraps` the
    // child ids. It auto-sizes to enclose them (+ `pad`); `z:-1` puts it behind.
    { "id": "serving-box", "type": "box", "title": "Serving layer",
      "wraps": ["lakehouse", "lakebase", "model-serving", "hosted-mcps"], "pad": 28, "z": -1 }
  ],
  "edges": []
}
]
