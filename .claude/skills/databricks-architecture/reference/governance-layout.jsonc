// =============================================================================
// GOVERNANCE / PHYSICAL LAYOUT — the Unity Catalog hierarchy as NESTED BOXES.
//
// JSONC for you to read; emit PLAIN JSON (strip //).
//
// Use this shape when the ask is about UC objects / org structure ("show our
// workspaces, metastore, catalogs, schemas"). It is CONTAINMENT, not a data flow.
//
// The model it draws (Unity Catalog semantics):
//   • the Account holds one Metastore per region;
//   • the Metastore OWNS the catalogs (catalog ⊃ schemas ⊃ tables / models);
//   • Workspaces are ATTACHED to the metastore and BIND to the catalogs they may
//     use — drawn as an edge, not by nesting a catalog inside a workspace.
//
// What it demonstrates:
//   • Containment only: Account ⊃ Metastore ⊃ Catalogs ⊃ schemas. Each box holds its
//     children, so the nesting is the structure.
//   • One column per catalog inside the metastore row, so sibling schemas stack tidily.
//   • The workspaces sit in a row under the metastore, in catalog order (prod, then dev).
//     Each workspace's edge goes to its catalog's models tile.
// Keep it to schema level; list key tables in a schema's caption if needed.
// =============================================================================
[
  {
    "name": "Unity Catalog layout",
    "story": "How Unity Catalog is organized: one account and one metastore that owns a prod and a dev catalog (bronze/silver/gold schemas + models); the prod and dev workspaces are attached to the metastore and each binds to its catalog.",
    "aspect": "1:1",
    "theme": "slide",
    "direction": "matrix",
    "options": {"trademarkLogos":false},
    "layout": "row",
    "nodes": [
      {"id": "account", "type": "box", "title": "Databricks account", "titleIcon": "file:vendor/databricks-admin", "layout": "column", "gap": 62, "align": "center", "children": [
        {"id": "metastore", "type": "box", "title": "Unity Catalog metastore", "titleIcon": "databricksMetastore", "ai_reasoning": "The metastore owns the catalogs, so they are its children. Workspaces stay outside and bind via edges.", "layout": "row", "gap": 77, "align": "center", "children": [
          {"id": "cat-prod", "type": "box", "title": "Catalog prod", "titleIcon": "dbCatalog", "layout": "column", "gap": 30, "align": "center", "children": [
            {"id": "prod-bronze", "type": "logo", "icon": "bronzeLayer", "text": "Bronze", "caption": "right", "track": "line-prod-bronze"},
            {"id": "prod-silver", "type": "logo", "icon": "silverLayer", "text": "Silver", "caption": "right", "track": "line-prod-silver"},
            {"id": "prod-gold", "type": "logo", "icon": "goldLayer", "text": "Gold", "caption": "right", "track": "line-prod-gold"},
            {"id": "prod-models", "type": "logo", "icon": "mlModelBrand", "text": "Models", "caption": "right", "track": "line-prod-models"}
          ] },
          {"id": "cat-dev", "type": "box", "title": "Catalog dev", "titleIcon": "dbCatalog", "layout": "column", "gap": 30, "align": "center", "children": [
            {"id": "dev-bronze", "type": "logo", "icon": "bronzeLayer", "text": "Bronze", "caption": "right", "track": "line-prod-bronze"},
            {"id": "dev-silver", "type": "logo", "icon": "silverLayer", "text": "Silver", "caption": "right", "track": "line-prod-silver"},
            {"id": "dev-gold", "type": "logo", "icon": "goldLayer", "text": "Gold", "caption": "right", "track": "line-prod-gold"},
            {"id": "dev-models", "type": "logo", "icon": "mlModelBrand", "text": "Models", "caption": "right", "track": "line-prod-models"}
          ] }
        ] },
        {"id": "row-ws-prod", "type": "group", "layout": "row", "gap": 76, "align": "center", "children": [
          {"id": "ws-prod", "type": "logo", "icon": "file:vendor/databricks", "text": "Prod workspace", "caption": "right", "ai_reasoning": "Workspaces sit beside the metastore, not inside it: they attach to it and bind to their catalog with an edge."},
          {"id": "ws-dev", "type": "logo", "icon": "file:vendor/databricks", "text": "Dev workspace", "caption": "right"}
        ] }
      ] }
    ],
    "edges": [
      {"id": "e-ws-prod", "from": "ws-prod", "to": "prod-models", "label": "binds", "arrow": "end", "ai_reasoning": "Leaf to leaf (trap 3): lands on the catalog's nearest schema rather than on the catalog box border."},
      {"id": "e-ws-dev", "from": "ws-dev", "to": "dev-models", "label": "binds", "arrow": "end"}
    ]
  }
]
