      {"id": "e4", "from": "silver", "to": "gold", "label": "aggregate", "flow": true, "color": "#FF5F46"},
      {"id": "e5", "from": "gold", "to": "dash", "label": "dashboard feed", "color": "#FF5F46"},
      {"id": "e6", "from": "gold", "to": "genie", "label": "Genie feed", "color": "#FF5F46"},
