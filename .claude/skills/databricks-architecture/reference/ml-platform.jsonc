// =============================================================================
// ML PLATFORM — end-to-end machine learning on Databricks, composed as nested containers.
//
// JSONC for you to read; emit PLAIN JSON (strip //).
//
// Four strands of the story, each one a row of the platform's middle column:
//   strand 1  sources → medallion (+ Feature Store fork) → training → registry
//   strand 2  batch scoring job ← registry; predictions land back in the medallion
//   strand 3  real-time serving → app; app state in Lakebase (synced gold)
//   strand 4  documents → vector search → RAG endpoint → app ·· AI Gateway
// STRUCTURE (reference/layout.md). The top level is a row: the sources column, then the platform box.
//   • The sources column (`equal: "w"`) holds the PDF docs (`track: "docs"`), Postgres and the sensors.
//   • The platform box is a column: a banner row (the db-platform wordmark and the governance
//     bar, spread by `justify: "between"`), then a body row of three columns:
//       – data: the medallion, alone in its column (it is tall, so nothing sits under it)
//       – ml: three rows, the RAG path (vector search → RAG endpoint), the training path
//         (training → registry) and the scoring path (batch scoring, real-time serving)
//       – apps: the AI Gateway, the app and Lakebase
//   • Shared tracks line the strands up across the columns: `docs` (PDFs and vector search),
//     `train` (medallion and training), `serve` (real-time serving and the app).
//
// What it demonstrates:
//   • medallion-table `params.feature_store` → a Feature Store fork + `@out-fs`
//     (training reads FEATURES, not raw gold); `@out-gold` feeds Lakebase.
//   • the medallion is TALL and has its column to itself, so its height needs no clearance.
//   • `lakeflow-jobs` relabeled as a batch scoring job (there is no dedicated
//     type) — one tile, one label, no hidden description.
//   • the RAG branch on its own row, and the AI Gateway next to the app whose
//     model calls it governs (a short edge, not a long line across the diagram).
//   • the platform box wraps the Databricks part only; the wordmark and the governance bar
//     share its banner row.
// This is a detail view. For a one-slide overview keep one serving story
// (training → registry → real-time app) and move batch/RAG to a second tab.
// =============================================================================
[
  {
    "name": "ML Platform",
    "story": "Ingest Postgres, sensor and PDF data into a governed lakehouse, engineer features, train and register a model with MLflow, then serve it in real time to an app and as a nightly batch job. A RAG endpoint answers over the documents, app state lives in Lakebase, and frontier-model calls go through the Unity AI Gateway. Networking and CI/CD out of scope.",
    "aspect": "16:9",
    "theme": "slide",
    "direction": "horizontal",
    "frame": {"title":"ML platform on Databricks","subtitle":"Features → training → registry → batch, real-time and RAG serving"},
    "options": {"trademarkLogos":true},
    "layout": "row",
    "gap": 90,
    "nodes": [
      {"id": "sources", "type": "group", "layout": "column", "gap": 60, "equal": "w", "children": [
        {"id": "src-pdf", "type": "source", "label": "PDF docs", "icon": "pdfLogo", "ai_reasoning": "tracked with Vector Search so the feed is one straight line", "track": "docs"},
        {"id": "src-postgres", "type": "source", "label": "Postgres", "icon": "file:vendor/postgresql"},
        {"id": "src-sensors", "type": "source", "label": "Sensor data", "icon": "sensorSource"}
      ] },
      {"id": "platform", "type": "box", "layout": "column", "gap": 40, "align": "stretch", "children": [
        {"id": "bar", "type": "group", "layout": "row", "justify": "between", "children": [
          {"id": "db-platform", "type": "db-platform"},
          {"id": "governance", "type": "governance-block", "params": {"genie_ontology": false, "ai_gateway": false}, "ai_reasoning": "ai_gateway surface off: the standalone Unity AI Gateway tile already shows it, next to the app it governs."}
        ] },
        {"id": "body", "type": "group", "layout": "row", "gap": 90, "align": "start", "children": [
          {"id": "data", "type": "group", "layout": "column", "gap": 60, "children": [
            {"id": "medallion", "type": "medallion-table", "params": {"feature_store": true}, "ai_reasoning": "Tracked with training so the features run straight across; batch predictions come back into gold.", "track": "train"}
          ] },
          {"id": "ml", "type": "group", "layout": "column", "gap": 60, "children": [
            {"id": "rag-path", "type": "group", "layout": "row", "gap": 90, "children": [
              {"id": "vector-search", "type": "vector-search", "track": "docs"},
              {"id": "rag", "type": "model-serving", "label": "RAG endpoint"}
            ] },
            {"id": "train-register", "type": "group", "layout": "row", "gap": 90, "children": [
              {"id": "training", "type": "model-training", "track": "train"},
              {"id": "registry", "type": "uc-model-registry"}
            ] },
            {"id": "scoring", "type": "group", "layout": "row", "gap": 90, "children": [
              {"id": "batch", "type": "lakeflow-jobs", "label": "Batch scoring", "ai_reasoning": "lakeflow-jobs relabeled; nightly predictions written back to gold."},
              {"id": "serving", "type": "model-serving", "label": "Real-time scoring", "track": "serve"}
            ] }
          ] },
          {"id": "apps", "type": "group", "layout": "column", "gap": 60, "children": [
            {"id": "ai-gateway", "type": "ai-gateway"},
            {"id": "app", "type": "databricks-apps-work", "track": "serve"},
            {"id": "lakebase", "type": "lakebase"}
          ] }
        ] }
      ] }
    ],
    "edges": [
      {"id": "e-pg", "from": "src-postgres", "to": "medallion@l", "flow": true},
      {"id": "e-sensors", "from": "src-sensors", "to": "medallion@l", "flow": true},
      {"id": "e-pdf", "from": "src-pdf", "to": "vector-search", "flow": true, "label": "Index documents"},
      {"id": "e-features", "from": "medallion@out-fs", "to": "training", "flow": true, "label": "Features"},
      {"id": "e-register", "from": "training", "to": "registry", "label": "Register"},
      {"id": "e-batch-load", "from": "registry", "to": "batch", "label": "Load champion"},
      {"id": "e-batch-write", "from": "batch", "to": "medallion@out-gold", "label": "Predictions", "ai_reasoning": "Predictions land back in the medallion (gold) for dashboards and apps. Enters the gold output port; the Lakebase sync leaves from the bottom instead, so the two never share a port."},
      {"id": "e-serve-load", "from": "registry", "to": "serving", "label": "Deploy"},
      {"id": "e-sync", "from": "medallion@b", "to": "lakebase@b", "flow": true, "label": "Sync gold", "ai_reasoning": "Lakebase serves the app, so it sits beside it; gold syncs into it."},
      {"id": "e-app-score", "from": "app", "to": "serving", "label": "Score"},
      {"id": "e-app-state", "from": "app@b", "to": "lakebase@t", "ai_reasoning": "No label: app ↔ Lakebase is self-evident, and the edge is long enough that a label would sit far from the tiles it explains."},
      {"id": "e-rag-vs", "from": "rag", "to": "vector-search", "label": "Top-k"},
      {"id": "e-app-rag", "from": "app", "to": "rag", "label": "Ask"},
      {"id": "e-gateway", "from": "app", "to": "ai-gateway", "label": "Model calls governed"}
    ]
  }
]
