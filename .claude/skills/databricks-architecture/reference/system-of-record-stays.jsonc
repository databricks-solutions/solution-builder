              {"id": "sources", "type": "group", "layout": "column", "gap": 30, "align": "center", "children": [
                {"id": "ing-kafka", "type": "source", "size": [230,62], "label": "Kafka ingest", "icon": "streaming", "desc": "Structured Streaming", "showDesc": true, "track": "line-ing-kafka"},
                {"id": "ing-al", "type": "source", "size": [230,62], "label": "Auto Loader", "icon": "inputData", "desc": "from cloud storage", "showDesc": true},
                {"id": "ing-lfc", "type": "source", "size": [230,62], "label": "Lakeflow Connect", "icon": "lakeflowConnectBrand", "desc": "Oracle Financials", "showDesc": true, "style": {"fill": "#eaf1fb", "borderColor": "#3b6fb5"}},
                {"id": "ing-copy", "type": "source", "size": [230,62], "label": "Lakeflow Batch", "icon": "jobsPipelines", "desc": "history backfill · COPY INTO", "showDesc": true, "track": "line-ing-copy"}
              ] },
              {"id": "col-med-bronze", "type": "group", "layout": "column", "gap": 30, "align": "center", "children": [
                {"id": "med-bronze", "type": "bronze-layer", "size": [320,88], "label": "Bronze — raw source entities", "desc": "as landed · append-only · lineage", "showDesc": true, "style": {"fill": "#fdf6ec", "borderColor": "#e0a030"}},
                {"id": "med-silver", "type": "silver-layer", "size": [320,88], "label": "Silver — conformed + history", "desc": "CDF + SCD Type 2 · full history", "showDesc": true, "style": {"fill": "#eef1f5", "borderColor": "#8a97a8"}},
                {"id": "med-gold", "type": "gold-layer", "size": [320,88], "label": "Gold — reporting", "desc": "business rules · star schemas", "showDesc": true, "style": {"fill": "#fdf6ec", "borderColor": "#e0a030"}}
              ] }
            ] },
            {"id": "governance", "type": "governance-block", "params": {"access_control": true, "ai_gateway": false, "genie_ontology": true}}
