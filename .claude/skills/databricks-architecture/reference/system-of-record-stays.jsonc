            {"id": "srv-sql", "type": "source", "size": [250,100], "label": "Databricks SQL", "icon": "sqlWarehouse", "desc": "governed serving layer", "showDesc": true, "track": "line-srv-sql"},
            {"id": "srv-dash", "type": "source", "size": [250,62], "label": "AI/BI Dashboards", "icon": "aibiBrand", "desc": "governed self-serve analytics", "showDesc": true, "track": "line-ing-copy"}
          ] }
        ] },
        {"id": "src-case", "type": "multi-source", "sources": [{"icon": "dbTable", "label": "Case data"}], "label": "Case management system", "at": [258,535]},
        {"id": "src-extract", "type": "multi-source", "sources": [{"icon": "file:vendor/oracle", "label": "GoldenGate CDC → cloud storage", "note": "change data capture", "wrap": true},{"icon": "streaming", "label": "Kafka topics", "note": "whole-database event feed", "wrap": true}], "label": "Existing extraction — reuse", "style": {"borderStyle": "solid", "borderColor": "#e0a030", "fill": "#fdf6ec"}, "at": [258,334]},
        {"id": "src-core", "type": "multi-source", "sources": [{"icon": "file:vendor/ibm", "label": "Mainframe · core entities and events"}], "label": "Core system of record", "style": {"borderStyle": "solid", "borderColor": "#4caf7d", "fill": "#e7f5ec"}, "at": [258,222]},
        {"id": "src-oracle", "type": "multi-source", "sources": [{"icon": "file:vendor/oracle", "label": "Financials"}], "label": "Oracle Financials", "style": {"borderStyle": "solid", "borderColor": "#3b6fb5", "fill": "#eaf1fb"}, "at": [258,446]},
        {"id": "h-sources", "type": "text", "size": [138,28], "text": "SOURCE SYSTEMS", "fontSize": 15, "bold": true, "at": [258,148]}
      ] },
      {"id": "col-h-consume", "type": "group", "layout": "column", "gap": 30, "align": "center", "children": [
