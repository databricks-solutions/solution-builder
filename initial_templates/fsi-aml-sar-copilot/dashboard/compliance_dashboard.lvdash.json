{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT COUNT(*) FROM gold_alert_queue) AS open_alerts,\n",
        "  (SELECT COUNT(*) FROM gold_alert_queue WHERE ml_risk_score >= 70) AS ml_critical_alerts,\n",
        "  (SELECT ROUND(SUM(CASE WHEN status='closed_no_sar' THEN 1 ELSE 0 END) / SUM(CASE WHEN status IN ('closed_no_sar','sar_filed') THEN 1 ELSE 0 END), 4) FROM alerts) AS false_positive_rate,\n",
        "  (SELECT COUNT(*) FROM sar_cases) + (SELECT COUNT(*) FROM case_decisions WHERE decision = 'file_sar') AS sars_filed,\n",
        "  (SELECT ROUND(AVG(CASE WHEN sla_breached THEN 1 ELSE 0 END), 4) FROM sar_cases WHERE detection_ts >= '2026-04-01') AS sla_breach_rate_recent,\n",
        "  (SELECT ROUND(AVG(days_to_file), 1) FROM sar_cases) AS avg_days_to_file\n"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Alert volume + false-positive rate by month",
      "queryLines": [
        "SELECT date_trunc('month', alert_ts) AS month, COUNT(*) AS alerts,\n  SUM(CASE WHEN status='closed_no_sar' THEN 1 ELSE 0 END) AS false_positives,\n  SUM(CASE WHEN status='sar_filed' THEN 1 ELSE 0 END) AS sar_filed,\n  SUM(CASE WHEN status IN ('open','in_review') THEN 1 ELSE 0 END) AS still_open,\n  CASE WHEN SUM(CASE WHEN status IN ('closed_no_sar','sar_filed') THEN 1 ELSE 0 END) >= 0.6 * COUNT(*)\n    THEN ROUND(SUM(CASE WHEN status='closed_no_sar' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN status IN ('closed_no_sar','sar_filed') THEN 1 ELSE 0 END),0), 4)\n    ELSE NULL END AS false_positive_rate\nFROM alerts WHERE alert_ts < '2026-09-01' GROUP BY 1"
      ]
    },
    {
      "name": "ds_monthly_status",
      "displayName": "Alerts by month and outcome",
      "queryLines": [
        "SELECT date_trunc('month', alert_ts) AS month,\n",
        "  CASE status WHEN 'closed_no_sar' THEN 'Closed - false positive' WHEN 'sar_filed' THEN 'SAR filed' ELSE 'Open / in review' END AS outcome, COUNT(*) AS alerts\n",
        "FROM alerts GROUP BY 1, 2\n"
      ]
    },
    {
      "name": "ds_scenario",
      "displayName": "False positives by TMS scenario",
      "queryLines": [
        "SELECT scenario, COUNT(*) AS alerts,\n",
        "  ROUND(SUM(CASE WHEN status='closed_no_sar' THEN 1 ELSE 0 END) / NULLIF(SUM(CASE WHEN status IN ('closed_no_sar','sar_filed') THEN 1 ELSE 0 END),0), 4) AS false_positive_rate,\n",
        "  ROUND(SUM(CASE WHEN status='closed_no_sar' THEN analyst_hours END), 0) AS hours_on_false_positives\n",
        "FROM alerts GROUP BY scenario\n"
      ]
    },
    {
      "name": "ds_sla",
      "displayName": "SAR filing SLA by month",
      "queryLines": [
        "SELECT date_trunc('month', detection_ts) AS month, COUNT(*) AS sars_filed,\n  ROUND(AVG(days_to_file), 1) AS avg_days_to_file,\n  SUM(CASE WHEN sla_breached THEN 1 ELSE 0 END) AS filed_late,\n  ROUND(AVG(CASE WHEN sla_breached THEN 1 ELSE 0 END), 4) AS late_rate\nFROM sar_cases WHERE detection_ts < '2026-08-01' GROUP BY 1\n"
      ]
    },
    {
      "name": "ds_ml_vs_rules",
      "displayName": "Open queue: rules rank vs ML risk",
      "queryLines": [
        "SELECT alert_id, customer_name, scenario, rules_rank, ml_rank, rule_score, ml_risk_score,\n",
        "  CASE WHEN cluster_size >= 3 THEN concat('Linked network (', cluster_size, ' parties)') ELSE 'No network' END AS network\n",
        "FROM gold_alert_queue\n"
      ]
    },
    {
      "name": "ds_networks",
      "displayName": "Entity networks with open alerts",
      "queryLines": [
        "SELECT cluster_id, cluster_size AS parties, open_alerts, sub_ctr_deposits_60d AS sub_ctr_deposits,\n  cash_branches_60d AS branches, cash_in_60d AS cash_in_60d_usd, high_risk_wires_60d AS high_risk_wires_usd,\n  array_join(slice(member_names, 1, 4), ', ') AS members\nFROM gold_network_clusters WHERE open_alerts > 0 ORDER BY open_alerts DESC, parties DESC\n\n"
      ]
    },
    {
      "name": "ds_decisions",
      "displayName": "Copilot decisions (write-back)",
      "queryLines": [
        "SELECT decided_ts, alert_id, decision, decided_by, amount_involved, bsa_filing_ref, days_to_decision,\n",
        "  substr(rationale, 1, 160) AS rationale FROM case_decisions\n"
      ]
    }
  ],
