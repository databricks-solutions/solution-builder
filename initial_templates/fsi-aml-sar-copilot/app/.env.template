# Local dev (./start.sh on :8811). Copy to .env. Auth comes from your ~/.databrickscfg profile
# whose host matches DATABRICKS_HOST (or DATABRICKS_CONFIG_PROFILE=<name> ./start.sh).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
DEMO_CATALOG=financial_services
DEMO_SCHEMA=aml_sar_copilot
AGENT_MODEL=databricks-claude-sonnet-4-5
GENIE_SPACE_ID=<genie-space-id>
DASHBOARD_ID=<dashboard-id>
LOCAL_USER_EMAIL=you@example.com
LOG_LEVEL=INFO
