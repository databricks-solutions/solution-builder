{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT ROUND(100 * SUM(units_shipped) / SUM(units_ordered), 1) FROM gold_fill_rate_weekly WHERE week_start > (SELECT date_sub(MAX(week_start), 28) FROM gold_fill_rate_weekly)) AS fill_rate_4w_pct,\n",
        "  (SELECT ROUND(100 * SUM(units_shipped) / SUM(units_ordered), 1) FROM gold_fill_rate_weekly WHERE plant_id = 'DAY' AND week_start > (SELECT date_sub(MAX(week_start), 28) FROM gold_fill_rate_weekly)) AS dayton_fill_rate_4w_pct,\n",
        "  (SELECT ROUND(SUM(revenue_at_risk), 0) FROM stockout_exposures) AS revenue_at_risk,\n",
        "  (SELECT COUNT(*) FROM stockout_exposures WHERE exposure_type = 'STOCKOUT') AS projected_stockouts,\n",
        "  (SELECT ROUND(SUM(eo_value), 0) FROM gold_inventory_health) AS eo_value,\n",
        "  (SELECT COUNT(*) FROM gold_open_purchase_orders WHERE is_delayed) AS delayed_pos\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "ds_fill_4w",
      "displayName": "Rolling 4-week fill rate (weekly)",
      "queryLines": [
        "WITH w AS (SELECT week_start, SUM(units_shipped) AS s, SUM(units_ordered) AS o,\n",
        "  SUM(CASE WHEN plant_id = 'DAY' THEN units_shipped END) AS ds, SUM(CASE WHEN plant_id = 'DAY' THEN units_ordered END) AS dordered\n",
        "  FROM gold_fill_rate_weekly GROUP BY week_start),\n",
        "r AS (SELECT week_start,\n",
        "  100 * SUM(s) OVER (ORDER BY week_start ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) / SUM(o) OVER (ORDER BY week_start ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS fill_rate_4w_pct,\n",
        "  100 * SUM(ds) OVER (ORDER BY week_start ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) / SUM(dordered) OVER (ORDER BY week_start ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS dayton_fill_rate_4w_pct\n",
        "  FROM w)\n",
        "SELECT week_start, ROUND(fill_rate_4w_pct / 100, 4) AS fill_rate_4w_pct, ROUND(dayton_fill_rate_4w_pct / 100, 4) AS dayton_fill_rate_4w_pct FROM r\n",
        "WHERE week_start > (SELECT date_sub(MAX(week_start), 182) FROM w)\n",
        "ORDER BY week_start\n"
      ]
    },
    {
      "name": "fill_trend",
      "displayName": "Fill rate by plant",
      "queryLines": [
        "SELECT week_start, plant_name, ROUND(100 * SUM(units_shipped) / SUM(units_ordered), 2) AS fill_rate_pct\n",
        "FROM gold_fill_rate_weekly\n",
        "WHERE week_start > (SELECT date_sub(MAX(week_start), 182) FROM gold_fill_rate_weekly)\n",
        "GROUP BY week_start, plant_name\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "exposures",
      "displayName": "Exposures + plan status",
      "queryLines": [
        "SELECT e.exposure_id, concat(e.component_id, ' @ ', e.plant_name) AS exposure, e.component_name, e.plant_name, e.exposure_type,\n",
        "  COALESCE(CAST(e.first_stockout_week AS STRING), 'Not at risk') AS first_stockout_label, e.peak_units_short,\n",
        "  CAST(ROUND(e.revenue_at_risk) AS BIGINT) AS revenue_at_risk, concat('$', format_number(CAST(ROUND(e.revenue_at_risk) AS BIGINT), 0)) AS revenue_label,\n",
        "  e.root_cause, e.primary_supplier, e.max_delay_days,\n",
        "  coalesce(p.plan_status, 'Open') AS plan_status, COALESCE(NULLIF(p.action_summary, ''), 'No plan yet') AS mitigation_label,\n",
        "  p.action_summary, p.plan_cost, p.revenue_protected\n",
        "FROM stockout_exposures e\n",
        "LEFT JOIN (SELECT exposure_id, 'Booked' AS plan_status, max_by(action_summary, booked_at) AS action_summary,\n",
        "                  max_by(plan_cost, booked_at) AS plan_cost, max_by(revenue_protected, booked_at) AS revenue_protected\n",
        "           FROM sop_plan_decisions GROUP BY exposure_id) p USING (exposure_id)\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "hx220",
      "displayName": "HX-220 Dayton projection",
      "queryLines": [
        "SELECT week_start, series, units FROM (\n",
        "  SELECT week_start, projected_balance AS `Projected (revised ETA)`, balance_if_on_time AS `If POs on time`, safety_stock_units AS `Safety stock`\n",
        "  FROM inventory_projection WHERE component_id = 'HX-220' AND plant_id = 'DAY')\n",
        "UNPIVOT (units FOR series IN (`Projected (revised ETA)`, `If POs on time`, `Safety stock`))\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "eo",
      "displayName": "E&O by plant",
      "queryLines": [
        "SELECT plant_name, eo_category, component_id, ROUND(eo_value, 0) AS eo_value, eo_units, days_since_last_issue\n",
        "FROM gold_inventory_health WHERE eo_value > 0\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "otd",
      "displayName": "Supplier on-time delivery",
      "queryLines": [
        "SELECT month, supplier_name, on_time_pct, avg_days_late, pos_received\n",
        "FROM gold_supplier_performance_monthly\n",
        "WHERE supplier_name IN ('Nanhai Precision Castings', 'Kessler Sensorik GmbH', 'Brightline Electronics', 'Voltara Motor Components')\n",
        "  AND month >= add_months((SELECT MAX(month) FROM gold_supplier_performance_monthly), -11)\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "delayed",
      "displayName": "Delayed inbound POs",
      "queryLines": [
        "SELECT po_number, supplier_name, component_id, plant_name, quantity, promised_date, revised_eta, delay_days, delay_reason, vessel\n",
        "FROM gold_open_purchase_orders WHERE is_delayed\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "demand",
      "displayName": "Demand actual vs AI_FORECAST",
      "queryLines": [
        "SELECT week_start, concat(sku, ' ', series) AS series, units\n",
        "FROM gold_demand_weekly WHERE plant_id = 'DAY' AND sku IN ('SG-250', 'SG-400', 'SG-600')\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    },
    {
      "name": "dos",
      "displayName": "Days of supply",
      "queryLines": [
        "SELECT plant_name, component_id, component_name, on_hand_units, avg_weekly_requirement, weeks_of_cover,\n",
        "  CAST(ROUND(days_of_supply) AS BIGINT) AS days_of_supply, eo_category,\n",
        "  concat('$', format_number(CAST(ROUND(inventory_value, 0) AS BIGINT), 0)) AS inventory_label,\n",
        "  CAST(ROUND(inventory_value, 0) AS BIGINT) AS inventory_value\n",
        "FROM gold_inventory_health\n"
      ],
      "catalog": "manufacturing",
      "schema": "supply_planning_copilot"
    }
  ],
