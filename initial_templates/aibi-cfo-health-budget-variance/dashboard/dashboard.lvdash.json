{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs (YTD, one row per fiscal_month)",
      "queryLines": [
        "-- One dataset feeding all four headline counters. One row per fiscal_month carrying each\n",
        "-- KPI as a running-YTD column; every counter reads the LATEST month via its period encoding\n",
        "-- (and the fiscal_month column keeps the global date filter working). Merged from the former\n",
        "-- ds_kpi_variance / ds_kpi_margin / ds_kpi_revenue / ds_kpi_agency.\n",
        "WITH v AS (\n",
        "  SELECT fiscal_month,\n",
        "         SUM(COALESCE(actual_opex_usd, forecast_opex_usd) - budget_opex_usd)\n",
        "           OVER (ORDER BY fiscal_month) AS full_year_variance_usd\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_opex_forecast\n",
        "),\n",
        "mm AS (\n",
        "  SELECT r.fiscal_month, r.net_patient_revenue_usd - o.opex_usd AS monthly_margin_usd\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_revenue r\n",
        "  JOIN (SELECT fiscal_month, COALESCE(actual_opex_usd, forecast_opex_usd) AS opex_usd\n",
        "        FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_opex_forecast) o USING (fiscal_month)\n",
        "),\n",
        "m AS (\n",
        "  SELECT fiscal_month,\n",
        "         SUM(monthly_margin_usd) OVER (ORDER BY fiscal_month) AS ytd_operating_margin_usd\n",
        "  FROM mm\n",
        "),\n",
        "r AS (\n",
        "  SELECT fiscal_month,\n",
        "         SUM(net_patient_revenue_usd) OVER (ORDER BY fiscal_month)\n",
        "           / NULLIF(SUM(prior_year_revenue_usd) OVER (ORDER BY fiscal_month), 0) - 1 AS revenue_yoy_pct\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_revenue\n",
        "),\n",
        "am AS (\n",
        "  SELECT fiscal_month, SUM(total_labor_cost_usd) AS monthly_agency_usd\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_staffing_summary\n",
        "  WHERE worker_type = 'Agency' GROUP BY fiscal_month\n",
        "),\n",
        "a AS (\n",
        "  SELECT fiscal_month,\n",
        "         SUM(monthly_agency_usd) OVER (ORDER BY fiscal_month) AS agency_labor_spend_usd\n",
        "  FROM am\n",
        ")\n",
        "SELECT v.fiscal_month,\n",
        "       v.full_year_variance_usd,\n",
        "       m.ytd_operating_margin_usd,\n",
        "       r.revenue_yoy_pct,\n",
        "       a.agency_labor_spend_usd\n",
        "FROM v\n",
        "JOIN m USING (fiscal_month)\n",
        "JOIN r USING (fiscal_month)\n",
        "JOIN a USING (fiscal_month)\n",
        "ORDER BY v.fiscal_month"
      ]
    },
    {
      "name": "ds_revenue",
      "displayName": "Revenue vs prior year",
      "queryLines": [
        "SELECT fiscal_month, 'This year' AS series, net_patient_revenue_usd AS revenue_usd FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_revenue\n",
        "UNION ALL\n",
        "SELECT fiscal_month, 'Prior year' AS series, prior_year_revenue_usd AS revenue_usd FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_revenue\n",
        "ORDER BY fiscal_month, series"
      ]
    },
    {
      "name": "ds_forecast",
      "displayName": "Opex forecast vs budget",
      "queryLines": [
        "-- WIDE format off the pre-built dbdemos_templates.aibi_cfo_health_budget_variance.gold_opex_forecast, one row per\n",
        "-- fiscal_month, so the native forecast-line widget can plot the actual line, the\n",
        "-- projected line and its confidence band (opex_upper/opex_lower) with no manual\n",
        "-- series. Elapsed months carry actual (band null); the last actual month is a bridge\n",
        "-- row (forecast = actual, band collapsed to the point) so the projected line connects;\n",
        "-- future months carry the projection + band. Budget is a flat reference annotation on\n",
        "-- the widget, not a series here.\n",
        "WITH f AS (SELECT * FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_opex_forecast),\n",
        "last_actual AS (SELECT MAX(fiscal_month) AS max_d FROM f WHERE series_type = 'actual')\n",
        "-- Actual months (excluding the bridge month)\n",
        "SELECT fiscal_month,\n",
        "       actual_opex_usd,\n",
        "       CAST(NULL AS DOUBLE) AS forecast_opex_usd,\n",
        "       CAST(NULL AS DOUBLE) AS opex_upper,\n",
        "       CAST(NULL AS DOUBLE) AS opex_lower\n",
        "FROM f WHERE series_type = 'actual' AND fiscal_month <> (SELECT max_d FROM last_actual)\n",
        "UNION ALL\n",
        "-- Bridge row at the last actual month: actual + projected start the same point\n",
        "SELECT fiscal_month, actual_opex_usd, forecast_opex_usd,\n",
        "       forecast_opex_usd AS opex_upper, forecast_opex_usd AS opex_lower\n",
        "FROM f WHERE fiscal_month = (SELECT max_d FROM last_actual)\n",
        "UNION ALL\n",
        "-- Future months: projection + confidence band, no actual\n",
        "SELECT fiscal_month, CAST(NULL AS DOUBLE) AS actual_opex_usd,\n",
        "       forecast_opex_usd, opex_upper, opex_lower\n",
        "FROM f WHERE series_type = 'forecast'\n",
        "ORDER BY fiscal_month"
      ]
    },
    {
      "name": "ds_cum_var",
      "displayName": "Cumulative variance to budget",
      "queryLines": [
        "SELECT fiscal_month, series_type,\n",
        "       SUM(COALESCE(actual_opex_usd, forecast_opex_usd)) OVER (ORDER BY fiscal_month)\n",
        "       - SUM(budget_opex_usd) OVER (ORDER BY fiscal_month) AS cumulative_variance_usd\n",
        "FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_opex_forecast"
      ]
    },
    {
      "name": "ds_variance",
      "displayName": "Budget variance by department & category",
      "queryLines": [
        "-- One dataset at (department, expense_category) grain feeding BOTH the by-department bar and\n",
        "-- the by-category bar. Merged from the former ds_dept_var + ds_cat_var. Carries two direction\n",
        "-- columns so each widget stays visually identical after re-aggregation: dept_direction (net over\n",
        "-- the department, so a department bar is one colored segment) and variance_direction (row/category\n",
        "-- sign, for the category bar under the Nursing filter). Keeps `department` for the global filter.\n",
        "SELECT department, expense_category, variance_usd, variance_pct,\n",
        "       CASE WHEN SUM(variance_usd) OVER (PARTITION BY department) >= 0\n",
        "            THEN 'Over budget' ELSE 'Under budget' END AS dept_direction,\n",
        "       CASE WHEN variance_usd >= 0 THEN 'Over budget' ELSE 'Under budget' END AS variance_direction\n",
        "FROM (\n",
        "  SELECT department, expense_category,\n",
        "         SUM(variance_usd) AS variance_usd,\n",
        "         SUM(variance_usd) / NULLIF(SUM(budget_ytd_usd), 0) AS variance_pct\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_budget_variance\n",
        "  GROUP BY department, expense_category\n",
        ")"
      ]
    },
    {
      "name": "ds_staffing",
      "displayName": "Staffing hours, cost & indexed hours",
      "queryLines": [
        "-- One dataset at (fiscal_month, department, worker_type) grain feeding BOTH the avg-$/hr bar and\n",
        "-- the indexed-hours line. Merged from the former ds_staffing + ds_staffing_index. hours_indexed is\n",
        "-- each (department, worker_type) series normalised to its own first (January) month = 100, computed\n",
        "-- with a window (equivalent to the old MIN(fiscal_month) join) so the SUM the line widget takes over\n",
        "-- worker_type reproduces the prior curves. Keeps fiscal_month + department for the global filters.\n",
        "WITH m AS (\n",
        "  SELECT fiscal_month, department, worker_type,\n",
        "         SUM(total_hours) AS total_hours,\n",
        "         SUM(total_labor_cost_usd) AS total_labor_cost_usd,\n",
        "         SUM(total_labor_cost_usd) / NULLIF(SUM(total_hours),0) AS avg_hourly_cost_usd\n",
        "  FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_staffing_summary\n",
        "  GROUP BY fiscal_month, department, worker_type\n",
        ")\n",
        "SELECT fiscal_month, department, worker_type,\n",
        "       total_hours,\n",
        "       total_labor_cost_usd,\n",
        "       avg_hourly_cost_usd,\n",
        "       total_hours\n",
        "         / NULLIF(FIRST_VALUE(total_hours) OVER (\n",
        "             PARTITION BY department, worker_type ORDER BY fiscal_month\n",
        "             ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING), 0)\n",
        "         * 100 AS hours_indexed\n",
        "FROM m\n",
        "ORDER BY fiscal_month"
      ]
    },
    {
      "name": "ds_vendor",
      "displayName": "Agency spend by vendor",
      "queryLines": [
        "SELECT vendor_name, department, SUM(spend_ytd_usd) AS spend_ytd_usd,\n",
        "       MAX(yoy_multiple) AS yoy_multiple\n",
        "FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_vendor_spend GROUP BY vendor_name, department ORDER BY spend_ytd_usd DESC"
      ]
    },
    {
      "name": "ds_facility_map",
      "displayName": "Over-budget by facility",
      "queryLines": [
        "SELECT facility_name, city, latitude, longitude,\n",
        "       total_variance_usd, nursing_contract_labor_variance_usd\n",
        "FROM dbdemos_templates.aibi_cfo_health_budget_variance.gold_facility_variance"
      ]
    }
  ],
