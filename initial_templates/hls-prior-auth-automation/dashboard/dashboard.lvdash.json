{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs (decided requests, last 120 days)",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS requests,\n",
        "  COUNT_IF(final_outcome IN ('Approved','Denied')) AS decided,\n",
        "  ROUND(COUNT_IF(final_outcome = 'Denied') / NULLIF(COUNT_IF(final_outcome IN ('Approved','Denied')), 0), 4) AS denial_rate,\n",
        "  ROUND(AVG(CASE WHEN urgency = 'Expedited' AND sla_met THEN 1 WHEN urgency = 'Expedited' AND sla_met = false THEN 0 END), 4) AS expedited_sla,\n",
        "  ROUND(AVG(CASE WHEN urgency = 'Standard' AND sla_met THEN 1 WHEN urgency = 'Standard' AND sla_met = false THEN 0 END), 4) AS standard_sla,\n",
        "  ROUND(PERCENTILE(turnaround_hours, 0.5), 1) AS median_tat_h,\n",
        "  ROUND(AVG(CASE WHEN criteria_met_on_first_review THEN 1 WHEN criteria_met_on_first_review = false THEN 0 END), 4) AS first_pass_clean,\n",
        "  COUNT_IF(final_outcome = 'Open') AS open_backlog\n",
        "FROM pa_requests\n"
      ]
    },
    {
      "name": "ds_weekly",
      "displayName": "Weekly SLA compliance, first-pass clean and auto-approval rate",
      "queryLines": [
        "SELECT DATE_TRUNC('WEEK', received_ts) AS week,\n",
        "  COUNT(*) AS requests,\n",
        "  ROUND(AVG(CASE WHEN sla_met THEN 1 WHEN sla_met = false THEN 0 END), 4) AS sla_compliance,\n",
        "  ROUND(AVG(CASE WHEN criteria_met_on_first_review THEN 1 WHEN criteria_met_on_first_review = false THEN 0 END), 4) AS first_pass_clean,\n",
        "  ROUND(COUNT_IF(decided_by_role = 'Automation') / NULLIF(COUNT_IF(final_outcome IN ('Approved','Denied')), 0), 4) AS auto_approval_rate,\n",
        "  ROUND(AVG(CASE WHEN urgency = 'Expedited' AND sla_met THEN 1 WHEN urgency = 'Expedited' AND sla_met = false THEN 0 END), 4) AS expedited_sla,\n",
        "  ROUND(AVG(CASE WHEN urgency = 'Standard' AND sla_met THEN 1 WHEN urgency = 'Standard' AND sla_met = false THEN 0 END), 4) AS standard_sla,\n",
        "  ROUND(COUNT_IF(final_outcome = 'Denied') / NULLIF(COUNT_IF(final_outcome IN ('Approved','Denied')), 0), 4) AS denial_rate,\n",
        "  ROUND(PERCENTILE(turnaround_hours, 0.5), 1) AS median_tat_h\n",
        "FROM pa_requests\n",
        "WHERE final_outcome <> 'Open' AND received_ts < (SELECT MAX(as_of_ts) - INTERVAL 7 DAYS FROM snapshot_info)\n",
        "GROUP BY ALL HAVING COUNT(*) >= 100\n",
        "ORDER BY week"
      ]
    },
    {
      "name": "ds_exp_arrival",
      "displayName": "Expedited 72h compliance by arrival window x channel",
      "queryLines": [
        "SELECT CONCAT(CASE WHEN dayofweek(received_ts) IN (1,7) OR (dayofweek(received_ts)=6 AND hour(received_ts)>=15) THEN 'Weekend' ELSE 'Weekday' END, ' · ', channel) AS segment,\n",
        "  CASE WHEN (dayofweek(received_ts) IN (1,7) OR (dayofweek(received_ts)=6 AND hour(received_ts)>=15)) AND channel = 'Fax' THEN 'Weekend fax' ELSE 'All other segments' END AS focus,\n",
        "  COUNT(*) AS decided_requests,\n",
        "  ROUND(AVG(CASE WHEN sla_met THEN 1 ELSE 0 END), 4) AS sla_compliance,\n",
        "  COUNT_IF(sla_met = false) AS breaches\n",
        "FROM pa_requests WHERE urgency = 'Expedited' AND final_outcome IN ('Approved','Denied')\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_backlog",
      "displayName": "Open backlog by day (received but not yet decided)",
      "queryLines": [
        "WITH days AS (\n",
        "  SELECT explode(sequence(DATE(MIN(received_ts)) + 7, DATE((SELECT MAX(as_of_ts) FROM snapshot_info)), INTERVAL 1 DAY)) AS d FROM pa_requests)\n",
        "SELECT d AS day,\n",
        "  COUNT_IF(r.urgency = 'Standard') AS standard_open,\n",
        "  COUNT_IF(r.urgency = 'Expedited') AS expedited_open\n",
        "FROM days JOIN pa_requests r ON r.received_ts < CAST(d AS TIMESTAMP) + INTERVAL 8 HOURS\n",
        "  AND (r.decision_ts IS NULL OR r.decision_ts >= CAST(d AS TIMESTAMP) + INTERVAL 8 HOURS)\n",
        "GROUP BY d\n"
      ]
    },
    {
      "name": "ds_path",
      "displayName": "Turnaround by decision path",
      "queryLines": [
        "SELECT decision_path, COUNT(*) AS requests,\n",
        "  ROUND(PERCENTILE(turnaround_hours, 0.5), 1) AS median_tat_h\n",
        "FROM pa_requests WHERE decision_path IS NOT NULL GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_group",
      "displayName": "Pend rate and first-pass clean rate by practice group",
      "queryLines": [
        "SELECT p.practice_group,\n",
        "  COUNT(*) AS requests,\n",
        "  ROUND(AVG(CASE WHEN r.pend_count > 0 THEN 1 ELSE 0 END), 4) AS pend_rate,\n",
        "  ROUND(AVG(CASE WHEN r.criteria_met_on_first_review THEN 1 WHEN r.criteria_met_on_first_review = false THEN 0 END), 4) AS first_pass_clean\n",
        "FROM pa_requests r JOIN providers p ON p.provider_id = r.provider_id\n",
        "WHERE r.final_outcome <> 'Open' GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_pend_reasons",
      "displayName": "Top pend reasons",
      "queryLines": [
        "SELECT CONCAT(service_description, ' — ', REPLACE(pend_reason, 'Missing documentation: ', '')) AS pend_reason, COUNT(*) AS pends\n",
        "FROM pa_requests WHERE pend_reason IS NOT NULL GROUP BY ALL ORDER BY pends DESC LIMIT 8\n"
      ]
    },
    {
      "name": "ds_lanes",
      "displayName": "Open queue by AI pre-review lane",
      "queryLines": [
        "SELECT a.ai_lane, r.urgency, COUNT(*) AS open_requests\n",
        "FROM ai_case_review a JOIN pa_requests r ON r.request_id = a.request_id GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_writeback",
      "displayName": "Decisions recorded in the PA Copilot app (write-back)",
      "queryLines": [
        "SELECT COALESCE(decision, 'none yet') AS decision, COUNT(decision_id) AS decisions\n",
        "FROM (SELECT 1) LEFT JOIN um_decisions ON true GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_weekly_long",
      "displayName": "Weekly SLA and first-pass (long)",
      "queryLines": [
        "WITH w AS (SELECT DATE_TRUNC('WEEK', received_ts) AS week,\n",
        "  ROUND(AVG(CASE WHEN sla_met THEN 1 WHEN sla_met = false THEN 0 END), 4) AS sla_compliance,\n",
        "  ROUND(AVG(CASE WHEN criteria_met_on_first_review THEN 1 WHEN criteria_met_on_first_review = false THEN 0 END), 4) AS first_pass_clean,\n",
        "  COUNT(*) AS requests\n",
        "FROM pa_requests\n",
        "WHERE final_outcome <> 'Open' AND received_ts < (SELECT MAX(as_of_ts) - INTERVAL 7 DAYS FROM snapshot_info)\n",
        "GROUP BY ALL HAVING COUNT(*) >= 100)\n",
        "SELECT week, 'SLA met' AS measure, sla_compliance AS value FROM w\n",
        "UNION ALL SELECT week, 'Clean on first review' AS measure, first_pass_clean AS value FROM w\n",
        "ORDER BY week"
      ]
    },
    {
      "name": "ds_backlog_long",
      "displayName": "Open backlog by urgency (long)",
      "queryLines": [
        "WITH b AS (WITH days AS (\n",
        "  SELECT explode(sequence(DATE(MIN(received_ts)) + 7, DATE((SELECT MAX(as_of_ts) FROM snapshot_info)), INTERVAL 1 DAY)) AS d FROM pa_requests)\n",
        "SELECT d AS day,\n",
        "  COUNT_IF(r.urgency = 'Standard') AS standard_open,\n",
        "  COUNT_IF(r.urgency = 'Expedited') AS expedited_open\n",
        "FROM days JOIN pa_requests r ON r.received_ts < CAST(d AS TIMESTAMP) + INTERVAL 8 HOURS\n",
        "  AND (r.decision_ts IS NULL OR r.decision_ts >= CAST(d AS TIMESTAMP) + INTERVAL 8 HOURS)\n",
        "GROUP BY d)\n",
        "SELECT day, 'Standard' AS urgency, standard_open AS open_requests FROM b\n",
        "UNION ALL SELECT day, 'Expedited' AS urgency, expedited_open AS open_requests FROM b\n",
        "ORDER BY day"
      ]
    }
  ],
