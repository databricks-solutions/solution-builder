{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT avg(oee) FROM oee_daily WHERE line LIKE 'Line 2%' AND production_date >= current_date() - INTERVAL 7 DAYS) AS line2_oee_7d,\n",
        "  (SELECT avg(oee) FROM oee_daily WHERE line LIKE 'Line 2%' AND production_date BETWEEN current_date() - INTERVAL 63 DAYS AND current_date() - INTERVAL 21 DAYS) AS line2_oee_baseline,\n",
        "  (SELECT avg(oee) FROM oee_daily WHERE production_date >= current_date() - INTERVAL 30 DAYS) AS plant_oee_30d,\n",
        "  (SELECT ROUND(sum(unplanned_downtime_hours), 0) FROM oee_daily WHERE production_date >= current_date() - INTERVAL 30 DAYS) AS unplanned_downtime_h_30d,\n",
        "  (SELECT ROUND(sum(mtbf_hours * greatest(failures_12m, 1)) / greatest(sum(failures_12m), 1), 0) FROM asset_reliability_12m) AS plant_mtbf_hours,\n",
        "  (SELECT sum(total_cost_usd) FROM failure_events WHERE failure_ts >= current_timestamp() - INTERVAL 365 DAYS) AS failure_cost_12m,\n",
        "  (SELECT sum(downtime_cost_at_risk_usd) FROM asset_risk_scores) AS cost_at_risk_7d,\n",
        "  (SELECT count(*) FROM asset_risk_scores WHERE risk_tier IN ('Critical','High')) AS assets_at_risk\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_kpi_daily",
      "displayName": "Daily rolling KPIs (Line 2 OEE 7-d, downtime 30-d)",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT production_date AS day,\n",
        "    AVG(CASE WHEN line LIKE 'Line 2%' THEN oee END) AS l2_oee,\n",
        "    SUM(unplanned_downtime_hours) AS downtime_h\n",
        "  FROM oee_daily GROUP BY production_date),\n",
        "r AS (\n",
        "  SELECT day,\n",
        "    AVG(l2_oee) OVER (ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS line2_oee_7d,\n",
        "    ROUND(SUM(downtime_h) OVER (ORDER BY day ROWS BETWEEN 29 PRECEDING AND CURRENT ROW), 0) AS downtime_h_30d\n",
        "  FROM d)\n",
        "SELECT day, line2_oee_7d, downtime_h_30d FROM r\n",
        "WHERE day >= current_date() - INTERVAL 90 DAYS\n",
        "ORDER BY day\n"
      ]
    },
    {
      "name": "ds_oee_weekly",
      "displayName": "Daily OEE by line (7-day trailing)",
      "queryLines": [
        "WITH d AS (\n",
        "  SELECT production_date, line, AVG(oee) AS oee\n",
        "  FROM oee_daily WHERE production_date >= current_date() - INTERVAL 70 DAYS\n",
        "  GROUP BY production_date, line)\n",
        "SELECT production_date AS week, line,\n",
        "  AVG(oee) OVER (PARTITION BY line ORDER BY production_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS oee\n",
        "FROM d\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_failure_modes",
      "displayName": "Failure cost by mode (12 m)",
      "queryLines": [
        "SELECT replace(failure_mode, '_', ' ') AS failure_mode, count(*) AS failures,\n",
        "  sum(downtime_hours) AS downtime_hours, sum(total_cost_usd) AS total_cost_usd\n",
        "FROM failure_events WHERE failure_ts >= current_timestamp() - INTERVAL 365 DAYS GROUP BY ALL\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_mtbf",
      "displayName": "MTBF by asset type",
      "queryLines": [
        "SELECT asset_type, sum(failures_12m) AS failures,\n",
        "  sum(mtbf_hours * greatest(failures_12m, 1)) / greatest(sum(failures_12m), 1) AS mtbf_hours,\n",
        "  avg(mttr_hours) AS mttr_hours, sum(unplanned_downtime_hours_12m) AS downtime_hours\n",
        "FROM asset_reliability_12m GROUP BY asset_type\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_risk",
      "displayName": "Fleet risk (ML)",
      "queryLines": [
        "SELECT asset_id, asset_name, line, ROUND(risk_score, 0) AS risk_score, risk_tier, predicted_failure_mode,\n",
        "  CASE WHEN est_days_to_failure IS NULL THEN 'Not at risk' ELSE CAST(CAST(ROUND(est_days_to_failure) AS BIGINT) AS STRING) END AS days_label,\n",
        "  CONCAT(CAST(ROUND(risk_score, 0) AS BIGINT), ' %') AS risk_label,\n",
        "  CONCAT('$', FORMAT_NUMBER(ROUND(downtime_cost_at_risk_usd / 1000, 1), 1), 'k') AS cost_at_risk_label,\n",
        "  top_driver_1, last_pm_vendor, COALESCE(last_pm_lubricant, '—') AS last_pm_label\n",
        "FROM asset_health_current\n",
        "ORDER BY risk_score DESC\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_drift",
      "displayName": "Vibration vs baseline — Line 2 FANUC robots",
      "queryLines": [
        "SELECT feature_date, asset_id, vib_mean AS vibration_mm_s, temp_mean AS temperature_c\n",
        "FROM asset_health_features\n",
        "WHERE asset_id IN ('RA-203','RA-207','RA-211','RA-214','RA-201') AND feature_date >= current_date() - INTERVAL 60 DAYS\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_pm_lube",
      "displayName": "Preventive maintenance by lubricant (60 d)",
      "queryLines": [
        "SELECT w.work_order_id, w.asset_id, a.model, w.scheduled_ts, w.vendor, w.lubricant_used, w.notes,\n",
        "  r.risk_score, r.risk_tier, CONCAT(CAST(ROUND(r.risk_score, 0) AS BIGINT), ' %') AS risk_label\n",
        "FROM maintenance_work_orders w JOIN assets a USING (asset_id) LEFT JOIN asset_risk_scores r USING (asset_id)\n",
        "WHERE w.work_type = 'Preventive' AND a.asset_type = 'Robot' AND w.scheduled_ts >= current_timestamp() - INTERVAL 60 DAYS\n",
        "ORDER BY (w.lubricant_used LIKE 'Mobilgrease%') DESC, r.risk_score DESC, w.scheduled_ts DESC\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    },
    {
      "name": "ds_downtime_month",
      "displayName": "Unplanned downtime by month and line",
      "queryLines": [
        "SELECT date_trunc('MONTH', f.failure_ts) AS month, a.line, sum(f.downtime_hours) AS downtime_hours, sum(f.total_cost_usd) AS cost_usd\n",
        "FROM failure_events f JOIN assets a USING (asset_id)\n",
        "WHERE f.failure_ts < date_trunc('MONTH', current_date())\n",
        "GROUP BY ALL\n"
      ],
      "catalog": "manufacturing",
      "schema": "predictive_maintenance"
    }
  ],
