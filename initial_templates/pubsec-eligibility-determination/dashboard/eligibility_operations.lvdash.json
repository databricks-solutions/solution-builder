{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Kpis",
      "queryLines": [
        "SELECT\n",
        "  ROUND(100 * AVG(CASE WHEN is_determined AND program = 'SNAP' AND determination_date >= add_months(current_date(), -3) THEN CAST(met_timeliness AS INT) END), 1) AS snap_on_time_pct,\n",
        "  ROUND(100 * AVG(CASE WHEN is_determined AND program = 'SNAP' AND county_name = 'Tamarack' AND determination_date >= add_months(current_date(), -3) THEN CAST(met_timeliness AS INT) END), 1) AS tamarack_on_time_pct,\n",
        "  COUNT_IF(is_open) AS open_backlog,\n",
        "  COUNT_IF(is_overdue) AS overdue_cases,\n",
        "  COUNT_IF(is_open AND expedited_screening AND days_open > 7) AS expedited_late\n",
        "FROM gold_applications\n"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "monthly",
      "displayName": "Monthly",
      "queryLines": [
        "SELECT determination_month, county_name,\n",
        "  ROUND(100 * AVG(CAST(met_timeliness AS INT)), 1) AS on_time_pct, COUNT(*) AS determinations\n",
        "FROM gold_applications\n",
        "WHERE is_determined AND program = 'SNAP'\n",
        "  AND determination_month >= add_months(date_trunc('MONTH', current_date()), -11)\n",
        "  AND determination_month < date_trunc('MONTH', current_date())\n",
        "GROUP BY ALL\n"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "scorecard",
      "displayName": "Scorecard",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT county_name,\n",
        "    ROUND(AVG(CASE WHEN program = 'SNAP' THEN CAST(met_timeliness AS INT) END), 3) AS snap_on_time_rate,\n",
        "    CAST(PERCENTILE(processing_days, 0.5) AS BIGINT) AS median_days,\n",
        "    ROUND(COUNT_IF(is_procedural_denial) / COUNT(*), 3) AS procedural_denial_rate,\n",
        "    ROUND(100 * COUNT_IF(is_procedural_denial) / COUNT(*), 1) AS procedural_denial_pct,\n",
        "    ROUND(100 * COUNT_IF(determination = 'APPROVED') / NULLIF(COUNT_IF(determination IN ('APPROVED','DENIED')), 0), 1) AS approval_pct,\n",
        "    ROUND(COUNT_IF(determination = 'APPROVED') / NULLIF(COUNT_IF(determination IN ('APPROVED','DENIED')), 0), 3) AS approval_rate\n",
        "  FROM gold_applications WHERE is_determined AND determination_date >= add_months(current_date(), -3) GROUP BY county_name)\n",
        "SELECT b.county_name, CASE WHEN b.county_name = 'Tamarack' THEN 'Tamarack' ELSE 'Rest of state' END AS source, b.region_type,\n",
        "  r.snap_on_time_rate, r.median_days, r.procedural_denial_rate, r.procedural_denial_pct, r.approval_pct, r.approval_rate,\n",
        "  CAST(b.open_cases AS BIGINT) AS open_cases, CAST(b.overdue_cases AS BIGINT) AS overdue_cases,\n",
        "  b.caseworker_fte, b.caseworker_fte_prior_year, b.open_cases_per_worker\n",
        "FROM gold_county_backlog b JOIN r USING (county_name)"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "equity_race",
      "displayName": "Equity Race",
      "queryLines": [
        "SELECT race_ethnicity,\n",
        "  ROUND(100 * COUNT_IF(determination = 'APPROVED') / NULLIF(COUNT_IF(determination IN ('APPROVED','DENIED')), 0), 1) AS approval_pct,\n",
        "  ROUND(100 * COUNT_IF(is_procedural_denial) / NULLIF(COUNT_IF(is_determined), 0), 1) AS procedural_denial_pct,\n",
        "  COUNT(*) AS applications\n",
        "FROM gold_applications GROUP BY race_ethnicity\n"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "channel_mix",
      "displayName": "Channel Mix",
      "queryLines": [
        "SELECT region_type, CONCAT(UPPER(SUBSTRING(REPLACE(channel, '_', ' '), 1, 1)), SUBSTRING(REPLACE(channel, '_', ' '), 2)) AS channel,\n",
        "  COUNT(*) AS applications, ROUND(AVG(CASE WHEN is_determined THEN processing_days END), 1) AS avg_processing_days\n",
        "FROM gold_applications GROUP BY ALL"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "denials",
      "displayName": "Denials",
      "queryLines": [
        "SELECT county_name, CONCAT(UPPER(SUBSTRING(REPLACE(denial_reason, '_', ' '), 1, 1)), SUBSTRING(REPLACE(denial_reason, '_', ' '), 2)) AS denial_reason, COUNT(*) AS denials\n",
        "FROM gold_applications WHERE determination = 'DENIED' AND determination_date >= add_months(current_date(), -6) GROUP BY ALL"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "extraction",
      "displayName": "Extraction",
      "queryLines": [
        "SELECT CONCAT(UPPER(SUBSTRING(REPLACE(doc_type, '_', ' '), 1, 1)), SUBSTRING(REPLACE(doc_type, '_', ' '), 2)) AS doc_type,\n",
        "  COUNT(*) AS documents, ROUND(100 * AVG(extraction_confidence), 1) AS avg_confidence_pct,\n",
        "  COUNT_IF(extraction_confidence < 0.9) AS low_confidence_docs\n",
        "FROM document_extractions GROUP BY doc_type"
      ],
      "catalog": "public_sector",
      "schema": "eligibility_determination"
    },
    {
      "name": "snap_monthly",
      "displayName": "SNAP on time by month (statewide, Tamarack)",
      "queryLines": [
        "SELECT determination_month,\n",
        "  ROUND(AVG(CAST(met_timeliness AS INT)), 3) AS statewide_on_time,\n",
        "  ROUND(AVG(CASE WHEN county_name = 'Tamarack' THEN CAST(met_timeliness AS INT) END), 3) AS tamarack_on_time\n",
        "FROM gold_applications\n",
        "WHERE is_determined AND program = 'SNAP'\n",
        "  AND determination_month >= add_months(date_trunc('MONTH', current_date()), -11)\n",
        "  AND determination_month < date_trunc('MONTH', current_date())\n",
        "GROUP BY determination_month ORDER BY determination_month"
      ]
    }
  ],
