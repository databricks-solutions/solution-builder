{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT\n",
        "  ROUND(COUNT_IF(source = 'Harborlight Library') / COUNT(*), 3) AS hb_share_catalogue_pct,\n",
        "  ROUND(SUM(CASE WHEN source = 'Harborlight Library' THEN impressions_4w END) / SUM(impressions_4w), 3) AS hb_share_impressions_pct,\n",
        "  ROUND(AVG(CASE WHEN source = 'Harborlight Library' THEN completeness_score END), 1) AS hb_avg_completeness,\n",
        "  ROUND(SUM(CASE WHEN source = 'Harborlight Library' THEN completions_4w END) / SUM(CASE WHEN source = 'Harborlight Library' THEN play_starts_4w END), 3) AS hb_completion_pct,\n",
        "  ROUND(SUM(CASE WHEN source <> 'Harborlight Library' THEN completions_4w END) / SUM(CASE WHEN source <> 'Harborlight Library' THEN play_starts_4w END), 3) AS rest_completion_pct,\n",
        "  COUNT_IF(hidden_gem) AS hidden_gems,\n",
        "  COUNT_IF(safety_risk) AS safety_risk_titles,\n",
        "  ROUND(COUNT_IF(completeness_score >= 80) / COUNT(*), 3) AS pct_library_at_80\n",
        "FROM gold_title_scorecard\n"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "weekly_kpi",
      "displayName": "Weekly Harborlight KPIs",
      "queryLines": [
        "SELECT week_start,\n  SUM(CASE WHEN library_group LIKE 'Harborlight%' THEN impressions END) / SUM(impressions) AS hb_share_impressions,\n  SUM(CASE WHEN library_group LIKE 'Harborlight%' THEN completions END)\n    / SUM(CASE WHEN library_group LIKE 'Harborlight%' THEN play_starts END) AS hb_completion_rate,\n  SUM(CASE WHEN library_group NOT LIKE 'Harborlight%' THEN completions END)\n    / SUM(CASE WHEN library_group NOT LIKE 'Harborlight%' THEN play_starts END) AS rest_completion_rate\nFROM gold_title_weekly\nWHERE week_start >= DATE'2026-04-13'\nGROUP BY week_start\nORDER BY week_start"
      ]
    },
    {
      "name": "by_source",
      "displayName": "Impressions per title by source",
      "queryLines": [
        "SELECT source, COUNT(*) AS titles, ROUND(AVG(impressions_4w)) AS impressions_per_title,\n",
        "  ROUND(100 * SUM(completions_4w) / SUM(play_starts_4w), 1) AS completion_pct, ROUND(AVG(completeness_score), 1) AS avg_completeness\n",
        "FROM gold_title_scorecard GROUP BY source"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "weekly",
      "displayName": "Weekly impressions per title by library group",
      "queryLines": [
        "SELECT week_start, library_group, ROUND(SUM(impressions) / COUNT(DISTINCT title_id)) AS impressions_per_title,\n",
        "  ROUND(SUM(play_starts) / COUNT(DISTINCT title_id), 1) AS play_starts_per_title\n",
        "FROM gold_title_weekly WHERE week_start >= DATE'2026-04-13' GROUP BY week_start, library_group"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "bands",
      "displayName": "Completeness band vs discovery",
      "queryLines": [
        "SELECT completeness_band, COUNT(*) AS titles, ROUND(AVG(impressions_4w)) AS impressions_per_title,\n",
        "  ROUND(100 * SUM(completions_4w) / SUM(play_starts_4w), 1) AS completion_pct\n",
        "FROM gold_title_scorecard GROUP BY completeness_band"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "pilot",
      "displayName": "Re-tag pilot lift",
      "queryLines": [
        "SELECT pilot_group, COUNT(*) AS titles,\n  CAST(SUM(impressions_4w_before) / COUNT(*) AS BIGINT) AS impressions_per_title_before,\n  CAST(SUM(impressions_4w_after) / COUNT(*) AS BIGINT) AS impressions_per_title_after,\n  CONCAT(CAST(ROUND(SUM(impressions_4w_after) / SUM(impressions_4w_before), 1) AS STRING), '×') AS impressions_lift,\n  CONCAT(CAST(ROUND(SUM(play_starts_4w_after) / SUM(play_starts_4w_before), 1) AS STRING), '×') AS play_starts_lift\nFROM gold_retag_pilot GROUP BY pilot_group ORDER BY pilot_group DESC"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "gems",
      "displayName": "Hidden gems",
      "queryLines": [
        "SELECT title, source, primary_genre, completeness_score, ai_completeness_score, impressions_4w, peer_impressions_4w,\n  CAST(ROUND(100 * completion_rate_4w) AS BIGINT) AS completion_pct, CAST(ROUND(100 * peer_completion_rate_4w) AS BIGINT) AS peer_completion_pct,\n  discovery_gap_impressions_4w, retag_priority_score\nFROM gold_title_scorecard WHERE hidden_gem ORDER BY retag_priority_score DESC LIMIT 50"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "safety",
      "displayName": "Safety risk by source",
      "queryLines": [
        "SELECT source, ai_brand_safety_tier AS should_be_tier, COUNT(*) AS titles\n",
        "FROM gold_title_scorecard WHERE safety_risk GROUP BY source, ai_brand_safety_tier"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "safety_list",
      "displayName": "Safety review list",
      "queryLines": [
        "SELECT title, source, maturity_rating, brand_safety_tier AS live_tier, ai_brand_safety_tier AS ai_tier,\n",
        "  array_join(missing_warnings, ', ') AS missing_warnings, array_join(collections, ', ') AS home_rows, impressions_4w\n",
        "FROM gold_title_scorecard WHERE safety_risk\n",
        "ORDER BY (array_contains(collections, 'Little Ones (under 7)') OR array_contains(collections, 'Family Movie Night')) DESC, impressions_4w DESC LIMIT 50"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    },
    {
      "name": "tagged_by",
      "displayName": "Who tagged the library",
      "queryLines": [
        "SELECT t.source, CASE m.tagged_by WHEN 'studio_feed' THEN 'Studio feed' WHEN 'vendor_feed' THEN 'Vendor feed' WHEN 'editor' THEN 'Editor' ELSE m.tagged_by END AS tagged_by, COUNT(*) AS titles, ROUND(AVG(m.completeness_score), 1) AS avg_completeness\nFROM titles t JOIN title_metadata m USING (title_id) GROUP BY t.source, CASE m.tagged_by WHEN 'studio_feed' THEN 'Studio feed' WHEN 'vendor_feed' THEN 'Vendor feed' WHEN 'editor' THEN 'Editor' ELSE m.tagged_by END"
      ],
      "catalog": "media_advertising",
      "schema": "content_metadata_copilot"
    }
  ],
