{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs",
      "queryLines": [
        "WITH m AS (SELECT month, sum(churned) c, sum(active_start) a FROM gold_churn_monthly GROUP BY month),\n",
        "s AS (SELECT sum(annual_revenue_at_risk) risk, count_if(risk_tier='Critical') crit FROM churn_scores WHERE risk_tier IN ('Critical','High')),\n",
        "h AS (SELECT avg(CASE WHEN offer_strategy LIKE 'Driver%' THEN CAST(saved AS INT) END) matched,\n",
        "             avg(CASE WHEN offer_strategy LIKE 'Blanket%' THEN CAST(saved AS INT) END) blanket,\n",
        "             sum(annual_revenue_saved) hist_saved FROM retention_offer_history WHERE offer_date >= '2026-08-01'),\n",
        "d AS (SELECT coalesce(sum(annual_revenue_saved),0) live_saved, count(*) live_n FROM retention_decisions)\n",
        "SELECT (SELECT c/a FROM m WHERE month = DATE'2026-09-01') AS churn_rate_current,\n",
        "       (SELECT sum(c)/sum(a) FROM m WHERE month < DATE'2026-07-01') AS churn_rate_baseline,\n",
        "       s.risk AS revenue_at_risk, s.crit AS critical_accounts,\n",
        "       h.matched AS save_rate_matched, h.blanket AS save_rate_blanket,\n",
        "       h.hist_saved + d.live_saved AS revenue_saved, d.live_n AS desk_decisions\n",
        "FROM s, h, d\n"
      ]
    },
    {
      "name": "ds_churn_month",
      "displayName": "Churn by month",
      "queryLines": [
        "SELECT month, round(sum(churned) / sum(active_start), 4) AS churn_rate ",
        "FROM gold_churn_monthly GROUP BY month ORDER BY month"
      ]
    },
    {
      "name": "ds_monthly_region",
      "displayName": "Monthly churn by region",
      "queryLines": [
        "SELECT month, region, sum(active_start) AS active_start, sum(churned) AS churned,\n",
        "       round(100 * sum(churned) / sum(active_start), 2) AS churn_rate_pct, sum(monthly_revenue_lost) AS monthly_revenue_lost\n",
        "FROM gold_churn_monthly GROUP BY month, region\n"
      ]
    },
    {
      "name": "ds_segment",
      "displayName": "Churn by segment before vs after July",
      "queryLines": [
        "SELECT segment, region, CASE WHEN month >= DATE'2026-07-01' THEN 'Jul–Sep 2026' ELSE 'Oct 2025–Jun 2026' END AS period,\n",
        "       round(100 * sum(churned) / sum(active_start), 2) AS churn_rate_pct\n",
        "FROM gold_churn_monthly GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_risk_driver",
      "displayName": "Revenue at risk by driver",
      "queryLines": [
        "SELECT c.region, c.market, c.segment, s.risk_tier,\n",
        "       CASE s.top_driver WHEN 'network' THEN 'Network quality' WHEN 'bill_shock' THEN 'Bill shock (promo roll-off)'\n",
        "         WHEN 'competitor' THEN 'Competitor (Crest)' WHEN 'care' THEN 'Care experience' ELSE 'Account profile' END AS top_driver,\n",
        "       count(*) AS accounts, sum(s.annual_revenue_at_risk) AS revenue_at_risk, sum(s.monthly_bill * 12) AS arpu_book\n",
        "FROM churn_scores s JOIN customers c USING (customer_id)\n",
        "WHERE s.risk_tier IN ('Critical','High') GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_strategy",
      "displayName": "Save rate by offer strategy (Aug–Sep)",
      "queryLines": [
        "SELECT offer_strategy, count(*) AS offers, round(100 * avg(CAST(saved AS INT)), 1) AS save_rate_pct,\n",
        "       round(avg(offer_cost), 0) AS avg_offer_cost, sum(annual_revenue_saved) AS revenue_saved\n",
        "FROM retention_offer_history WHERE offer_date >= '2026-08-01' GROUP BY 1\n"
      ]
    },
    {
      "name": "ds_offer_driver",
      "displayName": "Save rate by driver x offer",
      "queryLines": [
        "SELECT CASE primary_driver WHEN 'network' THEN 'Network' WHEN 'bill_shock' THEN 'Bill shock' WHEN 'competitor' THEN 'Competitor' ELSE 'Care' END AS driver,\n",
        "       o.offer_name, count(*) AS offers, round(100 * avg(CAST(saved AS INT)), 1) AS save_rate_pct\n",
        "FROM retention_offer_history h JOIN offer_catalog o USING (offer_code)\n",
        "GROUP BY ALL HAVING count(*) >= 25\n"
      ]
    },
    {
      "name": "ds_sites",
      "displayName": "Worst cell sites (Sep 2026)",
      "queryLines": [
        "SELECT cell_site_id, market, region, accounts, avg_dropped_call_rate_pct, avg_5g_download_mbps, churned,\n",
        "       CASE WHEN migrated_to_5g_sa_core THEN 'Yes (Jun 10)' ELSE 'No' END AS migrated_5g_sa_core\n",
        "FROM gold_network_sites WHERE month = DATE'2026-09-01' ORDER BY avg_dropped_call_rate_pct DESC LIMIT 12\n"
      ]
    },
    {
      "name": "ds_voice",
      "displayName": "Voice of customer (AI Functions)",
      "queryLines": [
        "SELECT CASE i.primary_intent WHEN 'competitor_offer' THEN 'Competitor offer' WHEN 'billing_dispute' THEN 'Billing dispute' WHEN 'plan_change' THEN 'Plan change' WHEN 'network_complaint' THEN 'Network complaint' WHEN 'device_support' THEN 'Device support' WHEN 'bill_shock' THEN 'Bill shock' ELSE i.primary_intent END AS intent, i.sentiment, c.region, count(*) AS calls, count_if(i.cancel_threat) AS cancel_threats\nFROM care_call_insights i JOIN customers c USING (customer_id) GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_decisions",
      "displayName": "Retention desk decisions (live write-back)",
      "queryLines": [
        "SELECT d.decided_at, d.customer_id, c.customer_name, c.region, d.offer_code, d.decision, d.offer_cost,\n",
        "       d.annual_revenue_saved, d.primary_driver, d.decided_by\n",
        "FROM retention_decisions d LEFT JOIN customers c USING (customer_id) ORDER BY d.decided_at DESC\n"
      ]
    }
  ],
