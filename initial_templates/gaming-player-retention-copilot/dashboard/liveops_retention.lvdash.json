{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT round(sum(CASE WHEN install_season='Season 6' THEN d7_retained END)/sum(CASE WHEN install_season='Season 6' AND d7_retained IS NOT NULL THEN installs END),4) d7_pre,\n",
        "         round(sum(CASE WHEN install_season='Season 7' THEN d7_retained END)/sum(CASE WHEN install_season='Season 7' AND d7_retained IS NOT NULL THEN installs END),4) d7_post\n",
        "  FROM gold_retention_cohorts),\n",
        "a AS (SELECT round(sum(CASE WHEN activity_date BETWEEN DATE'2026-07-14' AND DATE'2026-08-10' THEN revenue_usd END)/sum(CASE WHEN activity_date BETWEEN DATE'2026-07-14' AND DATE'2026-08-10' THEN dau END),3) arpdau_pre,\n",
        "             round(sum(CASE WHEN activity_date >= DATE'2026-08-25' THEN revenue_usd END)/sum(CASE WHEN activity_date >= DATE'2026-08-25' THEN dau END),3) arpdau_post FROM gold_daily_kpis),\n",
        "s AS (SELECT sum(at_risk_ltv_usd) at_risk_ltv, sum(players_at_risk) players_at_risk, sum(whales_at_risk) whales_at_risk FROM gold_risk_segments),\n",
        "q AS (SELECT count(*) scheduled FROM liveops_schedule)\n",
        "SELECT * FROM r, a, s, q\n"
      ]
    },
    {
      "name": "ds_arpdau_region_weekly",
      "displayName": "Weekly ARPDAU by region",
      "queryLines": [
        "SELECT date_trunc('WEEK', activity_date) AS week, region,\n  SUM(revenue_usd) / SUM(dau) AS arpdau\nFROM gold_daily_kpis\nGROUP BY date_trunc('WEEK', activity_date), region\nHAVING COUNT(DISTINCT activity_date) = 7\nORDER BY week"
      ]
    },
    {
      "name": "ds_arpdau_weekly",
      "displayName": "Weekly ARPDAU",
      "queryLines": [
        "SELECT date_trunc('WEEK', activity_date) AS week,\n  SUM(revenue_usd) / SUM(dau) AS arpdau\nFROM gold_daily_kpis\nGROUP BY date_trunc('WEEK', activity_date)\nHAVING COUNT(DISTINCT activity_date) = 7\nORDER BY week"
      ]
    },
    {
      "name": "ds_d7_weekly",
      "displayName": "Weekly D7 retention",
      "queryLines": [
        "SELECT date_trunc('WEEK', install_date) AS install_week,\n  SUM(d7_retained) / SUM(CASE WHEN d7_retained IS NOT NULL THEN installs END) AS d7\nFROM gold_retention_cohorts\nGROUP BY date_trunc('WEEK', install_date)\nHAVING COUNT(d7_retained) > 0\nORDER BY install_week"
      ]
    },
    {
      "name": "ds_cohorts",
      "displayName": "Retention cohorts by install week",
      "queryLines": [
        "SELECT date_trunc('WEEK', install_date) AS install_week, region, install_season,\n  sum(installs) installs, sum(d1_retained)/sum(CASE WHEN d1_retained IS NOT NULL THEN installs END) d1_rate,\n  sum(d7_retained)/sum(CASE WHEN d7_retained IS NOT NULL THEN installs END) d7_rate,\n  sum(d30_retained)/sum(CASE WHEN d30_retained IS NOT NULL THEN installs END) d30_rate\nFROM gold_retention_cohorts WHERE install_date BETWEEN DATE'2026-05-04' AND DATE'2026-09-20' GROUP BY ALL\nHAVING sum(installs) >= 100\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily DAU + ARPDAU",
      "queryLines": [
        "SELECT activity_date, region, season, dau, revenue_usd, new_installs, arpdau_usd FROM gold_daily_kpis\n"
      ]
    },
    {
      "name": "ds_stage",
      "displayName": "Season 7 stage funnel",
      "queryLines": [
        "SELECT concat(stage_id, ' ', stage_name) AS stage, stage_id, players_attempted, attempts, clears, attempt_clear_rate, players_stuck,\n  CASE WHEN attempt_clear_rate < 0.25 THEN 'Wall (under 25% clear)' ELSE 'Other stages' END AS stage_status\nFROM gold_stage_funnel WHERE season LIKE 'S7%' ORDER BY stage_id\n"
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Ranked queue wait by region",
      "queryLines": [
        "SELECT activity_date, region, queues, avg_queue_wait_sec, round(avg_queue_wait_sec/60, 2) AS avg_wait_min, abandon_rate FROM gold_matchmaking_daily\n"
      ]
    },
    {
      "name": "ds_churn",
      "displayName": "Weekly 14-day churn by cohort",
      "queryLines": [
        "SELECT week_start, region, player_type, tenure_band, sum(active_players) active_players, sum(churned_14d) churned_14d,\n",
        "  sum(churned_14d)/sum(active_players) churn_rate FROM gold_churn_weekly GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_risk",
      "displayName": "At-risk LTV by segment",
      "queryLines": [
        "SELECT segment_id, segment_name, initcap(churn_driver) AS churn_driver, region, players_at_risk, critical_players, whales_at_risk, avg_churn_probability, CAST(ROUND(at_risk_ltv_usd) AS BIGINT) AS at_risk_ltv_usd FROM gold_risk_segments\n"
      ]
    },
    {
      "name": "ds_tox",
      "displayName": "Chat moderation queue by AI label",
      "queryLines": [
        "SELECT date_trunc('WEEK', sent_date) AS week, toxicity_label, is_harmful, count(*) messages FROM chat_insights GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_history",
      "displayName": "Past interventions (holdout-measured)",
      "queryLines": [
        "SELECT concat(intervention_code, ' · ', season) AS run, intervention_code, strategy, target_driver, players_targeted, lift_pp, cost_usd, players_retained_incremental, cost_per_retained_player FROM liveops_history\n"
      ]
    },
    {
      "name": "ds_calendar",
      "displayName": "Live-ops calendar",
      "queryLines": [
        "SELECT 'Scheduled' AS status, start_date, intervention_code, intervention_name, churn_driver, region, players_targeted, CAST(ROUND(cost_usd) AS BIGINT) AS cost_usd, expected_players_retained AS players_retained, scheduled_by AS owner FROM liveops_schedule\nUNION ALL\nSELECT 'Completed (measured)', h.start_date, h.intervention_code, c.intervention_name, h.target_driver, 'ALL', h.players_targeted, CAST(ROUND(h.cost_usd) AS BIGINT) AS cost_usd, h.players_retained_incremental, h.season\nFROM liveops_history h JOIN intervention_catalog c USING (intervention_code)\n"
      ]
    }
  ],
