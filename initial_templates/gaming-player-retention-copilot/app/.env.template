# Local dev env for the Hollowspire Live-Ops Console. Copy to .env and fill in.
# Deployed values come from app.yaml (rendered by the bundle / scripts).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<your-warehouse-id>
WAREHOUSE_ID=<your-warehouse-id>

# Lakebase (from ./scripts/lakebase_setup_db.sh --db-name dbgen_player_retention)
LAKEBASE_ENDPOINT=projects/solution-builder/branches/production/endpoints/primary
PGHOST=<endpoint host printed by lakebase_setup_db.sh>
PGDATABASE=dbgen_player_retention
PGPORT=5432
PGSSLMODE=require

# Demo data + resources (from the setup job's export_resources output)
DEMO_CATALOG=gaming
DEMO_SCHEMA=player_retention_copilot
GENIE_SPACE_ID=
DASHBOARD_ID=
LAKEBASE_PROJECT_ID=solution-builder
AGENT_MLFLOW_EXPERIMENT_PATH=/Shared/solution_builder/player-retention-copilot-agent-traces
