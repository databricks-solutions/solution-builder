{
  "datasets": [
    {
      "name": "portfolio",
      "displayName": "Portfolio",
      "queryLines": [
        "WITH cur AS (SELECT trial_id, max_by(cum_randomized, month_start) AS randomized, max_by(planned_cum_randomized, month_start) AS planned_to_date, max_by(active_sites, month_start) AS active_sites FROM gold_trial_enrollment_monthly GROUP BY trial_id)\n",
        "SELECT t.acronym AS trial, t.phase, t.therapeutic_area, t.target_enrollment, c.randomized, c.planned_to_date,\n",
        "  ROUND(c.randomized / c.planned_to_date, 3) AS pct_of_plan, c.active_sites, t.planned_lpi_date, t.study_manager\n",
        "FROM trials t JOIN cur c USING (trial_id) ORDER BY pct_of_plan"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "portfolio_kpis",
      "displayName": "Portfolio Kpis",
      "queryLines": [
        "WITH cur AS (SELECT trial_id, max_by(cum_randomized, month_start) AS randomized, max_by(planned_cum_randomized, month_start) AS planned FROM gold_trial_enrollment_monthly GROUP BY trial_id)\n",
        "SELECT COUNT(*) AS active_trials, COUNT_IF(randomized / planned < 0.85) AS trials_behind_plan, SUM(randomized) AS randomized_total, ROUND(100 * MAX(CASE WHEN trial_id = 'CASCADE-CKD' THEN randomized / planned END), 1) AS cascade_pct_of_plan FROM cur\n"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "pct_of_plan_monthly",
      "displayName": "Pct Of Plan Monthly",
      "queryLines": [
        "SELECT trial_id AS trial, month_start, ROUND(100 * cum_randomized / planned_cum_randomized, 1) AS pct_of_plan\n",
        "FROM gold_trial_enrollment_monthly WHERE month_number >= 2 AND month_start < (SELECT MAX(month_start) FROM gold_trial_enrollment_monthly)"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "cascade_curve",
      "displayName": "Cascade Curve",
      "queryLines": [
        "SELECT month_start, 'Actual' AS series, cum_randomized AS randomized FROM gold_trial_enrollment_monthly\n",
        "WHERE trial_id = 'CASCADE-CKD' AND month_start < (SELECT MAX(month_start) FROM gold_trial_enrollment_monthly)\n",
        "UNION ALL SELECT month_start, 'Plan' AS series, planned_cum_randomized FROM enrollment_plan\n",
        "WHERE trial_id = 'CASCADE-CKD' AND month_start < (SELECT MAX(month_start) FROM gold_trial_enrollment_monthly)"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "cascade_kpis",
      "displayName": "Cascade Kpis",
      "queryLines": [
        "SELECT MAX(cum_randomized) AS randomized, MAX_BY(planned_cum_randomized, month_start) AS planned_to_date,\n",
        " (SELECT ROUND(COUNT_IF(outcome IN ('screen_failed','withdrawn')) / COUNT_IF(outcome <> 'in_screening'), 3) FROM screening_log WHERE trial_id = 'CASCADE-CKD') AS screen_fail_pct,\n",
        " (SELECT COUNT_IF(is_zero_enroller) FROM gold_site_performance WHERE trial_id = 'CASCADE-CKD') AS zero_enrollers\n",
        "FROM gold_trial_enrollment_monthly WHERE trial_id = 'CASCADE-CKD'"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "screen_fail_quarterly",
      "displayName": "Screen Fail Quarterly",
      "queryLines": [
        "SELECT concat(year(screen_month), '-Q', quarter(screen_month)) AS quarter,\n",
        "  CASE WHEN criterion_id IN ('E4','I3','E7','I2') THEN concat(criterion_id, ' ', criterion_name) ELSE 'Other criteria / consent' END AS reason,\n",
        "  SUM(screen_failures) AS screen_failures\n",
        "FROM gold_screen_fail_monthly\n",
        "WHERE trial_id = 'CASCADE-CKD'\n",
        "  AND screen_month < (SELECT DATE_TRUNC('QUARTER', MAX(screen_month)) FROM gold_screen_fail_monthly WHERE trial_id = 'CASCADE-CKD')\n",
        "GROUP BY ALL"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "coded_vs_ai",
      "displayName": "Coded Vs Ai",
      "queryLines": [
        "SELECT concat(criterion_id, ' ', REPLACE(criterion_name, '_', ' ')) AS criterion,\n",
        "  SUM(ai_recovered_failures) AS recovered_by_ai_functions\n",
        "FROM gold_screen_fail_monthly WHERE trial_id = 'CASCADE-CKD'\n",
        "GROUP BY ALL ORDER BY recovered_by_ai_functions DESC LIMIT 6"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "activation",
      "displayName": "Activation",
      "queryLines": [
        "SELECT irb_type, PERCENTILE(cycle_time_days, 0.5) AS median_days, COUNT(*) AS sites\n",
        "FROM gold_site_performance WHERE cycle_time_days IS NOT NULL GROUP BY irb_type"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "cascade_sites",
      "displayName": "Cascade Sites",
      "queryLines": [
        "SELECT site_name, city, state, irb_type, status, months_active, screened, randomized, randomized_per_month,\n",
        "  ROUND(screen_fail_rate, 3) AS screen_fail_pct, cycle_time_days, competing_trial, is_zero_enroller\n",
        "FROM gold_site_performance WHERE trial_id = 'CASCADE-CKD' ORDER BY randomized DESC"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "competitor",
      "displayName": "Competitor",
      "queryLines": [
        "SELECT CASE WHEN has_competing_trial THEN 'Shares REDWOOD-CKD' ELSE 'Other active sites' END AS site_group, COUNT(*) AS sites,\n",
        "  ROUND(SUM(randomized) / SUM(months_active), 2) AS randomized_per_site_month, ROUND(AVG(rand_per_month_since_competitor), 2) AS since_competitor\n",
        "FROM gold_site_performance WHERE trial_id = 'CASCADE-CKD' AND status = 'active' GROUP BY ALL"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "sglt2_trend",
      "displayName": "Sglt2 Trend",
      "queryLines": [
        "SELECT quarter_start, region, ROUND(100 * pct_on_sglt2i, 1) AS pct_on_sglt2i FROM population_trends\n",
        "WHERE quarter_start < (SELECT MAX(quarter_start) FROM population_trends)"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "rescue_candidates",
      "displayName": "Rescue Candidates",
      "queryLines": [
        "SELECT CAST(rescue_rank AS INT) AS rescue_rank, site_name, city, state, irb_type,\n",
        "  CAST(eligible_current_protocol AS INT) AS eligible_current_protocol, CAST(eligible_amended_e4 AS INT) AS eligible_amended_e4,\n",
        "  predicted_rate_current, predicted_rate_amended, est_activation_months, CAST(expected_randomized_12m AS INT) AS expected_randomized_12m\n",
        "FROM site_scores WHERE rescue_eligible ORDER BY rescue_rank LIMIT 25"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "clinical_trial_site_selection"
    },
    {
      "name": "enrollment_monthly",
      "displayName": "Enrollment by month (all trials)",
      "queryLines": [
        "SELECT month_start, SUM(cum_randomized) AS randomized_total\n",
        "FROM gold_trial_enrollment_monthly WHERE month_start < (SELECT MAX(month_start) FROM gold_trial_enrollment_monthly)\n",
        "GROUP BY month_start ORDER BY month_start"
      ]
    },
    {
      "name": "cascade_monthly",
      "displayName": "CASCADE-CKD by month",
      "queryLines": [
        "SELECT month_start, cum_randomized AS randomized, planned_cum_randomized AS planned,\n",
        "  cum_randomized / planned_cum_randomized AS pct_of_plan\n",
        "FROM gold_trial_enrollment_monthly WHERE trial_id = 'CASCADE-CKD' AND month_start < (SELECT MAX(month_start) FROM gold_trial_enrollment_monthly) AND planned_cum_randomized > 0\n",
        "ORDER BY month_start"
      ]
    },
    {
      "name": "screen_monthly",
      "displayName": "CASCADE-CKD screen-fail rate by month",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', screen_date) AS month_start,\n",
        "  COUNT_IF(outcome IN ('screen_failed', 'withdrawn')) / COUNT_IF(outcome <> 'in_screening') AS screen_fail_rate\n",
        "FROM screening_log\n",
        "WHERE trial_id = 'CASCADE-CKD'\n",
        "  AND DATE_TRUNC('MONTH', screen_date) < (SELECT DATE_TRUNC('MONTH', MAX(screen_date)) FROM screening_log WHERE trial_id = 'CASCADE-CKD')\n",
        "GROUP BY 1 ORDER BY 1"
      ]
    }
  ],
