{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Kpis",
      "queryLines": [
        "WITH m AS (SELECT month, SUM(claims) claims, SUM(units_in_service) units, SUM(warranty_cost) cost FROM gold_monthly_kpis GROUP BY month)\n",
        "SELECT\n",
        "  (SELECT ROUND(1000 * SUM(claims) / SUM(units), 1) FROM m WHERE month >= add_months(date_trunc('MONTH', current_date()), -3) AND month < date_trunc('MONTH', current_date())) AS claims_per_1k_3m,\n",
        "  (SELECT ROUND(1000 * SUM(claims) / SUM(units), 1) FROM m WHERE month >= add_months(date_trunc('MONTH', current_date()), -15) AND month < add_months(date_trunc('MONTH', current_date()), -3)) AS claims_per_1k_prior,\n",
        "  (SELECT ROUND(SUM(cost), 0) FROM m WHERE month >= add_months(date_trunc('MONTH', current_date()), -12)) AS warranty_cost_12m,\n",
        "  (SELECT ROUND(SUM(cost) / AVG(units), 2) FROM m WHERE month >= add_months(date_trunc('MONTH', current_date()), -12)) AS cost_per_bike_12m,\n",
        "  (SELECT ROUND(100 * SUM(recovered_amount) / SUM(supplier_attributable_cost), 1) FROM gold_supplier_recovery WHERE status = 'settled' AND quarter >= concat(year(add_months(current_date(), -12)), '-Q', quarter(add_months(current_date(), -12)))) AS recovery_rate_pct,\n",
        "  (SELECT COUNT(*) FROM gold_early_warning WHERE is_signal) AS open_signals\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "monthly",
      "displayName": "Monthly",
      "queryLines": [
        "SELECT month, 'All claims' AS series, ROUND(1000 * SUM(claims) / SUM(units_in_service), 2) AS claims_per_1k FROM gold_monthly_kpis WHERE NOT is_partial_month AND month >= add_months(date_trunc('MONTH', current_date()), -15) GROUP BY month\n",
        "UNION ALL\n",
        "SELECT month, 'Water ingress (AI)' AS series, ROUND(1000 * SUM(controller_water_claims) / SUM(units_in_service), 2) FROM gold_monthly_kpis WHERE NOT is_partial_month AND month >= add_months(date_trunc('MONTH', current_date()), -15) GROUP BY month\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "modes_90d",
      "displayName": "Modes 90D",
      "queryLines": [
        "SELECT failure_mode_label, COUNT(*) AS claims_90d, ROUND(SUM(total_cost),0) AS cost_90d, CASE WHEN failure_mode='controller_water_ingress' THEN 'Hanlin controller water ingress' ELSE 'Everyday failure modes' END AS source FROM gold_claims WHERE claim_status <> 'rejected' AND claim_date > date_sub(current_date(), 90) GROUP BY failure_mode_label, CASE WHEN failure_mode='controller_water_ingress' THEN 'Hanlin controller water ingress' ELSE 'Everyday failure modes' END"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "lots",
      "displayName": "Lots",
      "queryLines": [
        "SELECT controller_lot, water_claims_per_1k_unit_years, e21_bikes_per_1k_connected, units_built, water_ingress_claims, coalesce(pcn_reference, 'none') AS pcn_reference, ppap_status FROM gold_lot_quality WHERE supplier_id = 'SUP-HAN' AND production_start >= add_months(current_date(), -14)\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "early_warning",
      "displayName": "Early Warning",
      "queryLines": [
        "SELECT failure_mode_label, supplier_name, claims_90d, rate_90d_per_1k_unit_years, baseline_rate_per_1k_unit_years, rate_ratio, CAST(ROUND(cost_90d) AS BIGINT) AS cost_90d, concat('$', format_number(CAST(ROUND(cost_90d) AS BIGINT), 0)) AS cost_label, CASE WHEN is_signal THEN 'SIGNAL' ELSE '' END AS flag FROM gold_early_warning ORDER BY is_signal DESC, rate_ratio DESC\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "recovery",
      "displayName": "Recovery",
      "queryLines": [
        "SELECT supplier_name, ROUND(SUM(supplier_attributable_cost), 0) AS attributable_cost, ROUND(SUM(recovered_amount), 0) AS recovered, ROUND(SUM(supplier_attributable_cost - recovered_amount), 0) AS unrecovered, ROUND(100 * SUM(recovered_amount) / SUM(supplier_attributable_cost), 1) AS recovery_rate_pct FROM gold_supplier_recovery WHERE status = 'settled' AND quarter >= concat(year(add_months(current_date(), -12)), '-Q', quarter(add_months(current_date(), -12))) GROUP BY supplier_name\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "recovery_q",
      "displayName": "Recovery Q",
      "queryLines": [
        "SELECT quarter, supplier_name, supplier_attributable_claims, CAST(ROUND(supplier_attributable_cost) AS BIGINT) AS supplier_attributable_cost, CAST(ROUND(recovered_amount) AS BIGINT) AS recovered_amount, ROUND(100 * recovery_rate, 1) AS recovery_rate_pct, CONCAT(ROUND(100 * recovery_rate, 1), ' %') AS recovery_label, concat('$', format_number(CAST(ROUND(supplier_attributable_cost) AS BIGINT), 0)) AS cost_label, concat('$', format_number(CAST(ROUND(recovered_amount) AS BIGINT), 0)) AS recovered_label, status FROM gold_supplier_recovery ORDER BY quarter DESC, supplier_attributable_cost DESC\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "coding",
      "displayName": "Coding",
      "queryLines": [
        "SELECT dealer_labor_code, COUNT(*) AS claims FROM gold_claims WHERE failure_mode = 'controller_water_ingress' AND claim_status <> 'rejected' GROUP BY dealer_labor_code\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "region",
      "displayName": "Region",
      "queryLines": [
        "SELECT region, CASE WHEN wet_region THEN 'Wet region' ELSE 'Dry region' END AS climate, COUNT(*) AS claims FROM gold_claims WHERE failure_mode = 'controller_water_ingress' AND claim_status <> 'rejected' AND claim_date > date_sub(current_date(), 90) GROUP BY region, wet_region\n"
      ],
      "catalog": "manufacturing",
      "schema": "warranty_cost_optimization"
    },
    {
      "name": "ds_rate_monthly",
      "displayName": "Claims per 1k bikes by month (all claims)",
      "queryLines": [
        "SELECT month, ROUND(1000 * SUM(claims) / SUM(units_in_service), 2) AS claims_per_1k\n",
        "FROM gold_monthly_kpis WHERE NOT is_partial_month AND month >= add_months(date_trunc('MONTH', current_date()), -15)\n",
        "GROUP BY month ORDER BY month\n"
      ]
    },
    {
      "name": "ds_cost_monthly",
      "displayName": "Warranty cost by month",
      "queryLines": [
        "SELECT month, CAST(ROUND(SUM(warranty_cost)) AS BIGINT) AS warranty_cost\n",
        "FROM gold_monthly_kpis WHERE NOT is_partial_month AND month >= add_months(date_trunc('MONTH', current_date()), -13)\n",
        "GROUP BY month ORDER BY month\n"
      ]
    }
  ],
  "pages": [
