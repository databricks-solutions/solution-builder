{
  "datasets": [
    {
      "name": "kpi_system_monthly",
      "displayName": "System readmissions monthly",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', discharge_date) AS month,\n",
        "  sum(CAST(readmitted_30d AS INT)) AS readmits,\n",
        "  count(*) AS discharges\n",
        "FROM gold_discharges\n",
        "WHERE outcome_window_closed AND status = 'discharged' AND in_hrrp_window\n",
        "  AND DATE_TRUNC('MONTH', discharge_date) > (SELECT DATE_TRUNC('MONTH', MIN(discharge_date)) FROM gold_discharges)\n",
        "  AND DATE_TRUNC('MONTH', discharge_date) < (SELECT DATE_TRUNC('MONTH', MAX(discharge_date)) FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged')\n",
        "GROUP BY 1\n",
        "ORDER BY 1"
      ],
      "columns": [
        {
          "displayName": "System readmission %",
          "expression": "SUM(`readmits`) / SUM(`discharges`)"
        }
      ]
    },
    {
      "name": "kpi_4w_monthly",
      "displayName": "4 West HF monthly",
      "queryLines": [
        "SELECT DATE_TRUNC('MONTH', discharge_date) AS month,\n",
        "  sum(CAST(readmitted_30d AS INT)) AS readmits,\n",
        "  count(*) AS discharges,\n",
        "  sum(CAST(weekend_discharge AS INT)) AS weekend_discharges,\n",
        "  sum(CASE WHEN weekend_discharge AND followup_7d_scheduled THEN 1 ELSE 0 END) AS weekend_followups\n",
        "FROM gold_discharges\n",
        "WHERE outcome_window_closed AND status = 'discharged' AND unit_id = 'LRMC-4W' AND hrrp_condition = 'HF'\n",
        "  AND DATE_TRUNC('MONTH', discharge_date) > (SELECT DATE_TRUNC('MONTH', MIN(discharge_date)) FROM gold_discharges)\n",
        "  AND DATE_TRUNC('MONTH', discharge_date) < (SELECT DATE_TRUNC('MONTH', MAX(discharge_date)) FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged')\n",
        "GROUP BY 1\n",
        "ORDER BY 1"
      ],
      "columns": [
        {
          "displayName": "4W HF readmission %",
          "expression": "SUM(`readmits`) / SUM(`discharges`)"
        },
        {
          "displayName": "4W weekend 7-day follow-up %",
          "expression": "SUM(`weekend_followups`) / SUM(`weekend_discharges`)"
        }
      ]
    },
    {
      "name": "kpi_4w_before",
      "displayName": "4 West HF before (pre 26 weeks)",
      "queryLines": [
        "SELECT CAST(sum(CAST(readmitted_30d AS INT)) AS DOUBLE) / count(*) AS before_rate\n",
        "FROM gold_discharges\n",
        "WHERE outcome_window_closed AND status = 'discharged'\n",
        "  AND unit_id = 'LRMC-4W' AND hrrp_condition = 'HF' AND NOT last_26_weeks"
      ]
    },
    {
      "name": "penalty",
      "displayName": "Penalty",
      "queryLines": [
        "SELECT hospital_name, round(penalty_usd) AS penalty_usd, round(penalty_pct, 4) AS penalty_pct,\n",
        "  CASE top_condition WHEN 'THA_TKA' THEN 'Hip/knee' WHEN 'HF' THEN 'Heart failure' WHEN 'AMI' THEN 'Heart attack'\n",
        "    WHEN 'PN' THEN 'Pneumonia' WHEN 'COPD' THEN 'COPD' WHEN 'CABG' THEN 'Bypass graft' ELSE top_condition END AS top_condition,\n",
        "  hf_err_estimate, hf_err_last_6m, CAST(excess_readmissions AS INT) AS excess_readmissions\n",
        "FROM hrrp_penalty_estimate"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    },
    {
      "name": "penalty_total",
      "displayName": "Penalty Total",
      "queryLines": [
        "SELECT round(sum(penalty_usd)) AS penalty_usd, round(max(CASE WHEN hospital_id = 'LRMC' AND top_condition = 'HF' THEN top_condition_usd END)) AS lrmc_hf_line_usd, round(max(CASE WHEN hospital_id = 'LRMC' AND top_condition = 'HF' THEN top_condition_usd END) / 1000) AS lrmc_hf_line_k FROM hrrp_penalty_estimate"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    },
    {
      "name": "hf_trend",
      "displayName": "HF trend (Larkspur units)",
      "queryLines": [
        "SELECT * FROM (\n",
        "  WITH m AS (\n",
        "    SELECT discharge_month, CASE WHEN unit_id = 'LRMC-4W' THEN '4 West' ELSE 'Other Larkspur units' END AS unit_group,\n",
        "      sum(readmissions) AS rd, sum(discharges) AS dc\n",
        "    FROM gold_readmission_monthly WHERE hrrp_condition = 'HF' AND hospital_id = 'LRMC' GROUP BY ALL)\n",
        "  SELECT discharge_month, unit_group,\n",
        "    round(100 * sum(rd) OVER (PARTITION BY unit_group ORDER BY discharge_month ROWS BETWEEN 5 PRECEDING AND CURRENT ROW)\n",
        "               / sum(dc) OVER (PARTITION BY unit_group ORDER BY discharge_month ROWS BETWEEN 5 PRECEDING AND CURRENT ROW), 1) AS readmission_rate_pct,\n",
        "    sum(dc) OVER (PARTITION BY unit_group ORDER BY discharge_month ROWS BETWEEN 5 PRECEDING AND CURRENT ROW) AS discharges\n",
        "  FROM m)\n",
        "WHERE discharge_month >= '2025-01-01'\n",
        "  AND discharge_month < (SELECT DATE_TRUNC('MONTH', MAX(discharge_date)) FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged')\n",
        "ORDER BY discharge_month"
      ]
    },
    {
      "name": "unit_change",
      "displayName": "Larkspur HF change by unit",
      "queryLines": [
        "SELECT unit_id, unit_name, round(100 * count_if(readmitted_30d AND NOT last_26_weeks) / count_if(NOT last_26_weeks), 1) AS rate_before_pct,\n",
        " round(100 * count_if(readmitted_30d AND last_26_weeks) / count_if(last_26_weeks), 1) AS rate_last_26w_pct,\n",
        " round(100 * count_if(readmitted_30d AND last_26_weeks) / count_if(last_26_weeks) - 100 * count_if(readmitted_30d AND NOT last_26_weeks) / count_if(NOT last_26_weeks), 1) AS change_pts,\n",
        " count_if(last_26_weeks) AS discharges_last_26w\n",
        "FROM gold_discharges\n",
        "WHERE outcome_window_closed AND status = 'discharged' AND hrrp_condition = 'HF' AND hospital_id = 'LRMC'\n",
        "GROUP BY unit_id, unit_name\n",
        "HAVING count_if(last_26_weeks) >= 50\n",
        "ORDER BY change_pts DESC"
      ]
    },
    {
      "name": "weekday",
      "displayName": "Weekday",
      "queryLines": [
        "SELECT discharge_dow, CASE discharge_dow WHEN 'Mon' THEN 1 WHEN 'Tue' THEN 2 WHEN 'Wed' THEN 3 WHEN 'Thu' THEN 4 WHEN 'Fri' THEN 5 WHEN 'Sat' THEN 6 ELSE 7 END AS dow_order,\n",
        " CASE WHEN last_26_weeks THEN 'Last 26 weeks' ELSE 'Before' END AS period,\n",
        " round(100 * avg(CAST(followup_7d_scheduled AS INT)), 1) AS followup_booked_pct, round(100 * avg(CAST(readmitted_30d AS INT)), 1) AS readmission_rate_pct, count(*) AS discharges\n",
        "FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged' AND unit_id = 'LRMC-4W' AND hrrp_condition = 'HF' GROUP BY ALL"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    },
    {
      "name": "followup_effect",
      "displayName": "7-day follow-up effect by condition",
      "queryLines": [
        "SELECT CASE hrrp_condition WHEN 'HF' THEN 'Heart failure' WHEN 'AMI' THEN 'Heart attack' WHEN 'PN' THEN 'Pneumonia'\n",
        "  WHEN 'COPD' THEN 'COPD' WHEN 'THA_TKA' THEN 'Hip/knee' ELSE condition_label END AS condition_label,\n",
        "  CASE WHEN followup_7d_scheduled THEN 'With 7-day follow-up' ELSE 'No follow-up booked' END AS followup,\n",
        "  round(100 * sum(readmissions) / sum(discharges), 1) AS readmission_rate_pct, sum(discharges) AS discharges\n",
        "FROM gold_followup_effect WHERE hrrp_condition <> 'OTHER' GROUP BY ALL"
      ]
    },
    {
      "name": "hrrp_err",
      "displayName": "Hrrp Err",
      "queryLines": [
        "SELECT CASE WHEN hospital_id = 'LRMC' THEN 'Larkspur' ELSE 'Other hospitals' END AS hospital_group,\n",
        "  hospital_name, hospital_id, condition_label, hrrp_condition, discharges,\n",
        "  round(observed_rate, 4) AS observed_rate_pct, round(national_readmission_rate, 4) AS national_rate_pct,\n",
        "  err_estimate, err_last_6m, round(penalty_contribution * medicare_base_drg_payments) AS penalty_usd,\n",
        "  excess_readmissions,\n",
        "  concat(hospital_id, ' · ', CASE hrrp_condition WHEN 'THA_TKA' THEN 'Hip/knee' ELSE hrrp_condition END) AS hospital_condition\n",
        "FROM hrrp_performance\n",
        "ORDER BY err_estimate DESC"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    },
    {
      "name": "note_risks",
      "displayName": "Note Risks",
      "queryLines": [
        "SELECT 'Transportation barrier' AS risk, CASE WHEN note_transportation_barrier THEN 'Mentioned in note' ELSE 'Not mentioned' END AS in_note, round(100 * avg(CAST(readmitted_30d AS INT)), 1) AS readmission_rate_pct, count(*) AS discharges FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged' AND is_hrrp_condition AND note_transportation_barrier IS NOT NULL GROUP BY ALL\n",
        "UNION ALL SELECT 'Medication cost concern', CASE WHEN note_medication_affordability THEN 'Mentioned in note' ELSE 'Not mentioned' END, round(100 * avg(CAST(readmitted_30d AS INT)), 1), count(*) FROM gold_discharges WHERE outcome_window_closed AND status = 'discharged' AND is_hrrp_condition AND note_medication_affordability IS NOT NULL GROUP BY ALL"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    },
    {
      "name": "worklist",
      "displayName": "Worklist",
      "queryLines": [
        "SELECT patient_name, unit_id, condition_label, discharge_date,\n",
        "  round(risk_score, 4) AS risk_pct, round(risk_if_followup, 4) AS risk_if_followup_pct,\n",
        "  CASE WHEN followup_7d_scheduled THEN 'Booked' ELSE 'Not booked' END AS followup_7d_scheduled,\n",
        "  CASE WHEN transportation_barrier THEN 'Yes' ELSE 'No' END AS transportation_barrier,\n",
        "  risk_tier\n",
        "FROM transition_worklist WHERE hrrp_condition <> 'OTHER'"
      ],
      "catalog": "healthcare_lifesciences",
      "schema": "readmission_reduction"
    }
  ],
