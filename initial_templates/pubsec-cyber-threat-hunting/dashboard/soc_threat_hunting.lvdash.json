{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "SOC KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT round(avg((unix_timestamp(detected_ts) - unix_timestamp(first_malicious_ts)) / 3600), 1) FROM incidents) AS mttd_hours_all,\n",
        "  (SELECT round(avg((unix_timestamp(detected_ts) - unix_timestamp(first_malicious_ts)) / 86400), 1) FROM incidents WHERE category IN ('credential_compromise', 'data_mishandling')) AS mttd_days_identity,\n",
        "  (SELECT round(avg((unix_timestamp(contained_ts) - unix_timestamp(detected_ts)) / 3600), 1) FROM incidents) AS mttr_hours_all,\n",
        "  (SELECT count(*) FROM siem_alerts) AS alerts_90d,\n",
        "  (SELECT round(100 * avg(IF(disposition = 'true_positive', 1, 0)), 1) FROM siem_alerts WHERE disposition <> 'open') AS tp_rate_pct,\n",
        "  (SELECT count(*) FROM investigation_leads WHERE status = 'open') AS open_leads,\n",
        "  (SELECT count(*) FROM attack_techniques WHERE detection_coverage = 'none') AS techniques_without_detection\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "ds_soc_weekly",
      "displayName": "Weekly alerts and true positives",
      "queryLines": [
        "SELECT date_trunc('week', created_ts) AS week,\n  count(*) AS alerts,\n  round(100 * count_if(disposition = 'true_positive') / nullif(count_if(disposition <> 'open'), 0), 1) AS tp_rate_pct\nFROM siem_alerts\nWHERE created_ts < (SELECT date_trunc('week', max(created_ts)) FROM siem_alerts)\nGROUP BY date_trunc('week', created_ts)\nORDER BY week"
      ]
    },
    {
      "name": "incident_monthly",
      "displayName": "Incidents monthly",
      "queryLines": [
        "SELECT date_trunc('month', detected_ts) AS month,\n",
        "  CASE WHEN category IN ('credential_compromise', 'data_mishandling') THEN 'Identity & data' ELSE 'Malware, phishing, web, DoS' END AS incident_group,\n",
        "  round(avg((unix_timestamp(detected_ts) - unix_timestamp(first_malicious_ts)) / 3600), 1) AS mttd_hours,\n",
        "  round(avg((unix_timestamp(contained_ts) - unix_timestamp(detected_ts)) / 3600), 1) AS mttr_hours,\n",
        "  count(*) AS incidents\n",
        "FROM incidents GROUP BY ALL ORDER BY month\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "by_category",
      "displayName": "Incidents by category",
      "queryLines": [
        "SELECT replace(category, '_', ' ') AS category, CASE WHEN category='credential_compromise' THEN 'Slowest to detect' ELSE 'Other categories' END AS source, count(*) AS incidents,\n",
        "   round(avg((unix_timestamp(detected_ts) - unix_timestamp(first_malicious_ts)) / 86400), 1) AS mttd_days,\n",
        "   round(avg((unix_timestamp(contained_ts) - unix_timestamp(detected_ts)) / 3600), 1) AS mttr_hours,\n",
        "   round(100 * avg(IF(detection_source = 'external_notification', 1, 0)), 0) AS pct_found_by_outsiders\n",
        " FROM incidents GROUP BY ALL ORDER BY mttd_days DESC\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "alerts_weekly",
      "displayName": "Alerts weekly",
      "queryLines": [
        "SELECT date_trunc('week', created_ts) AS week, 'All alerts' AS series, count(*) AS alerts FROM siem_alerts\nWHERE date_trunc('week', created_ts) > (SELECT date_trunc('week', min(created_ts)) FROM siem_alerts)\n  AND date_trunc('week', created_ts) < (SELECT date_trunc('week', max(created_ts)) FROM siem_alerts)\nGROUP BY ALL\nUNION ALL\nSELECT date_trunc('week', created_ts), 'True positives', count_if(disposition = 'true_positive') FROM siem_alerts\nWHERE date_trunc('week', created_ts) > (SELECT date_trunc('week', min(created_ts)) FROM siem_alerts)\n  AND date_trunc('week', created_ts) < (SELECT date_trunc('week', max(created_ts)) FROM siem_alerts)\nGROUP BY ALL\nORDER BY week"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "rule_efficacy",
      "displayName": "Detection rule efficacy",
      "queryLines": [
        "SELECT rule_name, source, count(*) AS alerts, count_if(disposition = 'true_positive') AS true_positives,\n  CAST(round(100 * count_if(disposition = 'true_positive') / nullif(count_if(disposition <> 'open'), 0), 0) AS BIGINT) AS tp_rate_pct,\n  CAST(round(avg((unix_timestamp(closed_ts) - unix_timestamp(created_ts)) / 60), 0) AS BIGINT) AS avg_minutes_to_close\nFROM siem_alerts GROUP BY ALL ORDER BY alerts DESC"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "coverage",
      "displayName": "ATT&CK coverage",
      "queryLines": [
        "SELECT tactic, initcap(detection_coverage) AS detection_coverage, count(*) AS techniques FROM attack_techniques GROUP BY ALL ORDER BY tactic\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "spray_daily",
      "displayName": "Hosting-network password failures",
      "queryLines": [
        "SELECT date(event_ts) AS day, count(*) AS failed_signins, count(DISTINCT user_id) AS accounts_targeted,\n",
        "  max(per_acct) AS max_failures_per_account\n",
        "FROM (SELECT *, count(*) OVER (PARTITION BY user_id, date(event_ts)) AS per_acct FROM auth_logs\n",
        "      WHERE failure_reason = 'invalid_password' AND asn_org LIKE '%Hosting%')\n",
        "GROUP BY ALL ORDER BY day\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "failed_by_network",
      "displayName": "Failed sign-ins by network",
      "queryLines": [
        "SELECT date(event_ts) AS day, CASE WHEN asn_org LIKE '%Hosting%' THEN 'Hosting / VPS networks' ELSE 'CDOR + home ISPs' END AS network,\n",
        "  count(*) AS failed_signins FROM auth_logs WHERE failure_reason = 'invalid_password' GROUP BY ALL ORDER BY day\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "leads",
      "displayName": "UEBA leads",
      "queryLines": [
        "SELECT lead_id, entity_type, display_name, department, CAST(ROUND(risk_score) AS BIGINT) AS risk_score, priority, array_join(top_factors, '; ') AS top_factors,\n  linked_alerts, alerts_closed_fp, first_flagged FROM investigation_leads ORDER BY risk_score DESC\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "risk_trend",
      "displayName": "UEBA risk trend",
      "queryLines": [
        "SELECT d.score_date, i.display_name AS entity, d.risk_score FROM ueba_user_daily d JOIN identities i USING (user_id)\n",
        "WHERE d.user_id IN (SELECT entity_id FROM investigation_leads WHERE entity_type = 'user' ORDER BY risk_score DESC LIMIT 3)\n",
        "  AND d.score_date > (SELECT date_sub(max(score_date), 30) FROM ueba_user_daily)\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    },
    {
      "name": "dns_entropy",
      "displayName": "High-entropy DNS",
      "queryLines": [
        "SELECT host_id, count(*) AS high_entropy_lookups, count(DISTINCT date(event_ts)) AS days,\n",
        "  count_if(query_type = 'TXT') AS txt_lookups\n",
        "FROM dns_logs WHERE label_entropy > 3.5 AND length(split(query, '[.]')[0]) >= 12 GROUP BY ALL ORDER BY high_entropy_lookups DESC LIMIT 10\n"
      ],
      "catalog": "cybersecurity",
      "schema": "cyber_threat_hunting"
    }
  ],
