{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Kpis",
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(CASE WHEN signal_type NOT IN ('Death of spouse','New grandchild','External outflow','Refi window','Concentrated position') THEN amount END) / 1e6, 1) AS money_in_motion_m,\n",
        "  ROUND(SUM(CASE WHEN signal_type = 'CD maturity' THEN amount END) / 1e6, 1) AS cd_maturing_m,\n",
        "  ROUND(SUM(CASE WHEN signal_type = 'Refi window' THEN amount END) / 1e6, 1) AS refi_window_m\n",
        "FROM gold_household_signals\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "risk_kpis",
      "displayName": "Risk Kpis",
      "queryLines": [
        "SELECT ROUND(SUM(aum_at_risk) / 1e6, 1) AS aum_at_risk_m, COUNT_IF(aum_at_risk > 0) AS households_at_risk,\n",
        "  ROUND(100 * AVG(CAST(model_top_blocked AS INT)), 1) AS model_top_blocked_pct\n",
        "FROM household_opportunities\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "conv_trend",
      "displayName": "Conv Trend",
      "queryLines": [
        "SELECT month, ROUND(100 * SUM(CASE WHEN targeted THEN accepted END) / SUM(CASE WHEN targeted THEN offers END), 1) AS targeted_conversion_pct, ROUND(100 * SUM(CASE WHEN NOT targeted THEN accepted END) / SUM(CASE WHEN NOT targeted THEN offers END), 1) AS generic_conversion_pct FROM gold_nba_conversion GROUP BY month ORDER BY month\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "mim_by_signal",
      "displayName": "Mim By Signal",
      "queryLines": [
        "SELECT signal_type, COUNT(DISTINCT household_id) AS households, ROUND(SUM(amount) / 1e6, 1) AS amount_m\n",
        "FROM gold_household_signals WHERE signal_type NOT IN ('Death of spouse','New grandchild','External outflow')\n",
        "GROUP BY signal_type\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "flows_monthly",
      "displayName": "Flows Monthly",
      "queryLines": [
        "SELECT month, ROUND(SUM(sweep_cash) / 1e6, 1) AS sweep_cash_m, ROUND(SUM(external_outflows) / 1e6, 2) AS outflows_m,\n  ROUND(SUM(outflows_after_life_event) / 1e6, 2) AS outflows_after_life_event_m, ROUND(SUM(cash_outflows_to_online_banks) / 1e6, 2) AS cash_to_online_banks_m\nFROM gold_flows_monthly WHERE month < '2026-09-01' GROUP BY month\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "rates_long",
      "displayName": "Rates Long",
      "queryLines": [
        "SELECT month, 'Sweep account' AS product, CAST(sweep_rate_pct AS DOUBLE) AS rate_pct FROM market_rates\n",
        "UNION ALL SELECT month, 'Online bank savings', CAST(competitor_hysa_pct AS DOUBLE) FROM market_rates\n",
        "UNION ALL SELECT month, 'CD renewal, 12 mo', CAST(cd_12m_renewal_pct AS DOUBLE) FROM market_rates\n",
        "UNION ALL SELECT month, '30-yr mortgage', CAST(mortgage_30y_pct AS DOUBLE) FROM market_rates\n",
        "ORDER BY month\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "risk_by_advisor",
      "displayName": "Risk By Advisor",
      "queryLines": [
        "SELECT a.advisor_name, ROUND(SUM(o.aum_at_risk) / 1e6, 2) AS aum_at_risk_m, ROUND(SUM(o.money_in_motion) / 1e6, 1) AS money_in_motion_m, COUNT(*) AS households_with_signal\n",
        "FROM household_opportunities o JOIN advisors a USING (advisor_id) GROUP BY ALL ORDER BY aum_at_risk_m DESC LIMIT 12\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "top_opportunities",
      "displayName": "Top Opportunities",
      "queryLines": [
        "SELECT o.book_rank, a.advisor_name, o.primary_name, o.segment, ROUND(o.aum) AS aum, o.money_in_motion, o.aum_at_risk, o.signals,\n",
        "  o.top_model_action, o.top_model_status, o.best_suitable_action, o.priority_score\n",
        "FROM household_opportunities o JOIN advisors a USING (advisor_id) ORDER BY o.priority_score DESC LIMIT 25\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "conversion_by_approach",
      "displayName": "Conversion By Approach",
      "queryLines": [
        "SELECT CASE WHEN targeted THEN concat('Targeted, ', response_speed) ELSE 'Generic annual review' END AS approach,\n",
        "  SUM(offers) AS offers, ROUND(100.0 * SUM(accepted) / SUM(offers), 1) AS conversion_pct, ROUND(SUM(revenue_12m) / 1e3) AS revenue_k\n",
        "FROM gold_nba_conversion GROUP BY 1\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "conversion_by_action",
      "displayName": "Conversion By Action",
      "queryLines": [
        "SELECT CASE action_code WHEN 'ANNUAL-REVIEW' THEN 'Annual review' WHEN 'CASH-MMF' THEN 'Cash to money fund' WHEN 'CD-LADDER' THEN 'CD ladder' WHEN 'DIRECT-INDEX' THEN 'Direct index' WHEN 'EDU-529' THEN '529 education plan' WHEN 'ESTATE-REVIEW' THEN 'Estate review' WHEN 'IRA-ROLLOVER' THEN 'IRA rollover' WHEN 'MANAGED-PORTFOLIO' THEN 'Managed portfolio' WHEN 'MORTGAGE-REFI' THEN 'Mortgage refinance' WHEN 'PRIVATE-CREDIT' THEN 'Private credit' WHEN 'SBLOC' THEN 'Securities-backed loan' WHEN 'STRUCTURED-NOTE' THEN 'Structured note' ELSE action_code END AS action_code, ROUND(100.0 * SUM(accepted) / SUM(offers), 1) AS conversion_pct, SUM(offers) AS offers, SUM(complaints) AS complaints FROM gold_nba_conversion GROUP BY 1\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "retention",
      "displayName": "Retention",
      "queryLines": [
        "SELECT CASE WHEN advisor_contacted_within_30d THEN 'Advisor called within 30 days' ELSE 'Nobody called' END AS follow_up,\n",
        "  COUNT(*) AS events, ROUND(100 * AVG(assets_retained_pct), 1) AS assets_retained_pct, ROUND(SUM(outflows_6m) / 1e6, 1) AS outflows_m\n",
        "FROM gold_life_event_retention GROUP BY 1\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "complaints",
      "displayName": "Complaints",
      "queryLines": [
        "SELECT CASE WHEN would_fail_suitability THEN 'Fails suitability rules' ELSE 'Passes suitability rules' END AS suitability, CASE action_code WHEN 'ANNUAL-REVIEW' THEN 'Annual review' WHEN 'CASH-MMF' THEN 'Cash to money fund' WHEN 'CD-LADDER' THEN 'CD ladder' WHEN 'DIRECT-INDEX' THEN 'Direct index' WHEN 'EDU-529' THEN '529 education plan' WHEN 'ESTATE-REVIEW' THEN 'Estate review' WHEN 'IRA-ROLLOVER' THEN 'IRA rollover' WHEN 'MANAGED-PORTFOLIO' THEN 'Managed portfolio' WHEN 'MORTGAGE-REFI' THEN 'Mortgage refinance' WHEN 'PRIVATE-CREDIT' THEN 'Private credit' WHEN 'SBLOC' THEN 'Securities-backed loan' WHEN 'STRUCTURED-NOTE' THEN 'Structured note' ELSE action_code END AS action_code, COUNT_IF(complaint_filed) AS complaints, COUNT_IF(accepted) AS accepted_offers FROM nba_history WHERE accepted GROUP BY ALL\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "suitability_mix",
      "displayName": "Suitability Mix",
      "queryLines": [
        "SELECT CASE action_code WHEN 'ANNUAL-REVIEW' THEN 'Annual review' WHEN 'CASH-MMF' THEN 'Cash to money fund' WHEN 'CD-LADDER' THEN 'CD ladder' WHEN 'DIRECT-INDEX' THEN 'Direct index' WHEN 'EDU-529' THEN '529 education plan' WHEN 'ESTATE-REVIEW' THEN 'Estate review' WHEN 'IRA-ROLLOVER' THEN 'IRA rollover' WHEN 'MANAGED-PORTFOLIO' THEN 'Managed portfolio' WHEN 'MORTGAGE-REFI' THEN 'Mortgage refinance' WHEN 'PRIVATE-CREDIT' THEN 'Private credit' WHEN 'SBLOC' THEN 'Securities-backed loan' WHEN 'STRUCTURED-NOTE' THEN 'Structured note' ELSE action_code END AS action_code, CASE suitability_status WHEN 'FAIL' THEN 'Fails rules' WHEN 'PASS' THEN 'Passes rules' WHEN 'REVIEW' THEN 'Needs review' ELSE suitability_status END AS suitability_status, COUNT(*) AS scored_actions FROM nba_recommendations GROUP BY ALL\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    },
    {
      "name": "desk_activity",
      "displayName": "Desk Activity",
      "queryLines": [
        "SELECT * FROM (\n",
        "SELECT CAST(d.decided_at AS DATE) AS logged_at, 'Morning Book (live)' AS source, h.primary_first_name || ' ' || h.primary_last_name AS client,\n",
        "  a.advisor_name, CASE d.action_code WHEN 'ANNUAL-REVIEW' THEN 'Annual review' WHEN 'CASH-MMF' THEN 'Cash to money fund' WHEN 'CD-LADDER' THEN 'CD ladder' WHEN 'DIRECT-INDEX' THEN 'Direct index' WHEN 'EDU-529' THEN '529 education plan' WHEN 'ESTATE-REVIEW' THEN 'Estate review' WHEN 'IRA-ROLLOVER' THEN 'IRA rollover' WHEN 'MANAGED-PORTFOLIO' THEN 'Managed portfolio' WHEN 'MORTGAGE-REFI' THEN 'Mortgage refinance' WHEN 'PRIVATE-CREDIT' THEN 'Private credit' WHEN 'SBLOC' THEN 'Securities-backed loan' WHEN 'STRUCTURED-NOTE' THEN 'Structured note' ELSE d.action_code END AS action_code, COALESCE(d.decision, 'Not yet decided') AS decision, d.assets_in_scope AS assets_in_scope, CASE d.suitability_status WHEN 'FAIL' THEN 'Fails rules' WHEN 'PASS' THEN 'Passes rules' WHEN 'REVIEW' THEN 'Needs review' ELSE d.suitability_status END AS suitability_status\n",
        "FROM advisor_decisions d JOIN households h USING (household_id) JOIN advisors a ON a.advisor_id = d.advisor_id\n",
        "UNION ALL\n",
        "SELECT CAST(n.offer_date AS DATE), 'Offer history', h.primary_first_name || ' ' || h.primary_last_name, a.advisor_name,\n",
        "  CASE n.action_code WHEN 'ANNUAL-REVIEW' THEN 'Annual review' WHEN 'CASH-MMF' THEN 'Cash to money fund' WHEN 'CD-LADDER' THEN 'CD ladder' WHEN 'DIRECT-INDEX' THEN 'Direct index' WHEN 'EDU-529' THEN '529 education plan' WHEN 'ESTATE-REVIEW' THEN 'Estate review' WHEN 'IRA-ROLLOVER' THEN 'IRA rollover' WHEN 'MANAGED-PORTFOLIO' THEN 'Managed portfolio' WHEN 'MORTGAGE-REFI' THEN 'Mortgage refinance' WHEN 'PRIVATE-CREDIT' THEN 'Private credit' WHEN 'SBLOC' THEN 'Securities-backed loan' WHEN 'STRUCTURED-NOTE' THEN 'Structured note' ELSE n.action_code END, n.outcome, n.assets_moved, CASE WHEN n.would_fail_suitability THEN 'Fails rules' ELSE 'Passes rules' END\n",
        "FROM nba_history n JOIN households h USING (household_id) JOIN advisors a ON a.advisor_id = n.advisor_id\n",
        "WHERE n.offer_date >= DATE'2026-09-14' AND n.targeted\n",
        ") ORDER BY logged_at DESC LIMIT 200\n"
      ],
      "catalog": "financial_services",
      "schema": "wealth_advisor_nba"
    }
  ],
