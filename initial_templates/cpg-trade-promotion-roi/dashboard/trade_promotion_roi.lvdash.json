{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline KPIs (last 2 years)",
      "queryLines": [
        "SELECT\n  SUM(trade_spend_usd) AS trade_spend,\n  SUM(incremental_gross_profit_usd) AS incremental_gp,\n  SUM(net_profit_usd) AS net_profit,\n  SUM(net_profit_usd) / SUM(trade_spend_usd) AS roi,\n  AVG(CASE WHEN net_profit_usd < 0 THEN 1.0 ELSE 0.0 END) AS share_events_lost_money,\n  SUM(CASE WHEN retailer_name = 'ValuMax Stores' AND tactic = 'BOGO' THEN net_profit_usd END) AS valumax_bogo_net_profit\nFROM gold_event_roi\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_events",
      "displayName": "Completed promotions (post-event analysis)",
      "queryLines": [
        "SELECT event_id, event_name, retailer_name, channel, product_name, brand, tactic, funding_method, start_week, quarter,\n",
        "  discount_depth, volume_lift_pct, pantry_loading_pct_of_lift, cannibalization_pct_of_lift, forward_buy_units,\n",
        "  baseline_units, actual_units, gross_incremental_units, post_event_dip_units, cannibalized_units, net_incremental_units,\n",
        "  trade_spend_usd, incremental_gross_profit_usd, net_profit_usd, roi, verdict, is_last_52_weeks\n",
        "FROM gold_event_roi\nORDER BY net_profit_usd ASC\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_tactic",
      "displayName": "ROI by retailer x tactic",
      "queryLines": [
        "SELECT retailer_name, tactic, SUM(events) AS events, SUM(trade_spend_usd) AS trade_spend,\n",
        "  SUM(net_profit_usd) AS net_profit, SUM(net_profit_usd) / SUM(trade_spend_usd) AS roi,\n",
        "  SUM(gross_incremental_units) / SUM(baseline_units) AS volume_lift\n",
        "FROM gold_tactic_response GROUP BY ALL\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_leakage",
      "displayName": "Where the lift goes, by tactic",
      "queryLines": [
        "SELECT tactic, 'Net incremental' AS component, SUM(net_incremental_units) AS units FROM gold_event_roi GROUP BY tactic\n",
        "UNION ALL SELECT tactic, 'Pantry-loading dip', SUM(post_event_dip_units) FROM gold_event_roi GROUP BY tactic\n",
        "UNION ALL SELECT tactic, 'Cannibalized sister SKUs', SUM(cannibalized_units) FROM gold_event_roi GROUP BY tactic\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_spend_q",
      "displayName": "Trade spend by quarter and retailer",
      "queryLines": [
        "SELECT quarter, retailer_name, SUM(trade_spend_usd) AS trade_spend, SUM(net_profit_usd) AS net_profit\n",
        "FROM gold_event_roi GROUP BY ALL\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_plan",
      "displayName": "Next quarter promo plan forecast",
      "queryLines": [
        "SELECT plan_event_id, plan_week, start_week, retailer_name, product_name, tactic, discount_depth, funding_method,\n",
        "  forecast_units, trade_spend_usd, net_profit_usd, roi, forecast_flag, recommended_scenario_label, recommended_net_profit_usd, recommended_roi, planner_note\n",
        "FROM gold_plan_forecast\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_plan_kpi",
      "displayName": "Next quarter KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS planned_events, SUM(trade_spend_usd) AS planned_spend, SUM(net_profit_usd) AS forecast_net_profit,\n",
        "  SUM(net_profit_usd) / SUM(trade_spend_usd) AS forecast_roi,\n",
        "  COUNT_IF(forecast_flag = 'Money-losing') AS money_losing_events,\n",
        "  SUM(CASE WHEN forecast_flag = 'Money-losing' THEN recommended_net_profit_usd - net_profit_usd END) AS replan_upside\n",
        "FROM gold_plan_forecast\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    },
    {
      "name": "ds_replan",
      "displayName": "Money-losing events: as planned vs recommended",
      "queryLines": [
        "SELECT concat(plan_event_id, ' ', product_name) AS event, 'As planned' AS scenario, net_profit_usd AS net_profit FROM gold_plan_forecast WHERE forecast_flag = 'Money-losing'\n",
        "UNION ALL SELECT concat(plan_event_id, ' ', product_name), 'Recommended re-plan', recommended_net_profit_usd FROM gold_plan_forecast WHERE forecast_flag = 'Money-losing'\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "trade_promotion_roi"
    }
  ],
