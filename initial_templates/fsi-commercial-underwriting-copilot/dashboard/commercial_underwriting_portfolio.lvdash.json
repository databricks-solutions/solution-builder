{
  "datasets": [
    {
      "name": "ds_trailing",
      "displayName": "Trailing four quarters",
      "queryLines": [
        "WITH q AS (SELECT quarter, SUM(earned_premium) ep, SUM(incurred) inc,\n",
        "  SUM(CASE WHEN portfolio_cell = 'Habitational · Hail belt' THEN earned_premium END) hail_ep,\n",
        "  SUM(CASE WHEN portfolio_cell = 'Habitational · Hail belt' THEN incurred END) hail_inc,\n",
        "  SUM(CASE WHEN portfolio_cell = 'Habitational · Hail belt' AND roof_band = 'Roof > 15 yrs' THEN earned_premium END) old_ep,\n",
        "  SUM(CASE WHEN portfolio_cell = 'Habitational · Hail belt' AND roof_band = 'Roof > 15 yrs' THEN incurred END) old_inc\n",
        " FROM gold_portfolio_quarterly GROUP BY quarter),\n",
        "w AS (SELECT quarter,\n",
        "  COUNT(*) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) n4,\n",
        "  SUM(ep) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) ep4,\n",
        "  SUM(inc) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) inc4,\n",
        "  SUM(hail_ep) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) hail_ep4,\n",
        "  SUM(hail_inc) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) hail_inc4,\n",
        "  SUM(old_ep) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) old_ep4,\n",
        "  SUM(old_inc) OVER (ORDER BY quarter ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) old_inc4\n",
        " FROM q)\n",
        "SELECT make_date(CAST(LEFT(quarter, 4) AS INT), (CAST(RIGHT(quarter, 1) AS INT) - 1) * 3 + 1, 1) AS quarter_start,\n",
        "  quarter, ep4, inc4 / ep4 AS book_lr4, hail_inc4 / hail_ep4 AS hail_lr4, old_inc4 / old_ep4 AS old_lr4\n",
        "FROM w WHERE n4 = 4 ORDER BY quarter"
      ]
    },
    {
      "name": "ds_cell_trend",
      "displayName": "Loss ratio by portfolio cell and quarter",
      "queryLines": [
        "SELECT make_date(CAST(LEFT(quarter, 4) AS INT), (CAST(RIGHT(quarter, 1) AS INT) - 1) * 3 + 1, 1) AS quarter_start, t.*\n",
        "FROM (SELECT quarter, portfolio_cell, SUM(incurred) / SUM(earned_premium) AS loss_ratio\n",
        "FROM gold_portfolio_quarterly GROUP BY quarter, portfolio_cell) t\n"
      ]
    },
    {
      "name": "ds_roof_trend",
      "displayName": "Hail-belt habitational by roof band",
      "queryLines": [
        "SELECT make_date(CAST(LEFT(quarter, 4) AS INT), (CAST(RIGHT(quarter, 1) AS INT) - 1) * 3 + 1, 1) AS quarter_start, t.*\n",
        "FROM (SELECT quarter, roof_band, SUM(incurred) / SUM(earned_premium) AS loss_ratio, SUM(wind_hail_incurred) / SUM(incurred) AS wind_hail_share\n",
        "FROM gold_portfolio_quarterly WHERE portfolio_cell = 'Habitational · Hail belt' GROUP BY quarter, roof_band) t\n"
      ]
    },
    {
      "name": "ds_cell_compare",
      "displayName": "Last four vs prior four quarters",
      "queryLines": [
        "SELECT portfolio_cell,\n",
        "       SUM(CASE WHEN quarter BETWEEN '2024-Q3' AND '2025-Q2' THEN incurred END) / SUM(CASE WHEN quarter BETWEEN '2024-Q3' AND '2025-Q2' THEN earned_premium END) AS prior_4q_lr,\n",
        "       SUM(CASE WHEN quarter BETWEEN '2025-Q3' AND '2026-Q2' THEN incurred END) / SUM(CASE WHEN quarter BETWEEN '2025-Q3' AND '2026-Q2' THEN earned_premium END) AS last_4q_lr,\n",
        "       ROUND(SUM(CASE WHEN quarter BETWEEN '2025-Q3' AND '2026-Q2' THEN earned_premium END)) AS last_4q_earned_premium\n",
        "FROM gold_portfolio_quarterly GROUP BY portfolio_cell ORDER BY last_4q_lr DESC\n"
      ]
    },
    {
      "name": "ds_perils",
      "displayName": "Hail-belt habitational losses by peril",
      "queryLines": [
        "SELECT c.accident_quarter AS quarter, c.peril, SUM(c.incurred_amount) AS incurred\n",
        "FROM claims c JOIN policies p ON p.policy_id = c.policy_id\n",
        "WHERE p.segment_code = 'HAB' AND p.hail_belt GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_brokers",
      "displayName": "Broker performance (trailing 12 months)",
      "queryLines": [
        "SELECT broker_name, tier, submissions, quoted, bound, hit_ratio, bound_premium, book_loss_ratio\n",
        "FROM gold_broker_performance ORDER BY bound_premium DESC\n"
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Today's queue",
      "queryLines": [
        "SELECT q.submission_id, q.insured_name, q.broker_name, q.segment, q.state, ROUND(q.sov_tiv / 1e6, 1) AS tiv_musd, q.triage_lane, q.priority_score,\n",
        "       q.discrepancy_count, q.band_as_submitted, q.band_verified, q.days_to_effective, COALESCE(d.decision, 'Not issued') AS decision_issued\n",
        "FROM gold_submission_queue q LEFT JOIN v_uw_decisions_latest d USING (submission_id) ORDER BY q.priority_score DESC\n"
      ]
    },
    {
      "name": "ds_lanes",
      "displayName": "Queue by triage lane",
      "queryLines": [
        "SELECT triage_lane, COUNT(*) AS submissions, SUM(sov_tiv) AS tiv FROM gold_submission_queue GROUP BY triage_lane\n"
      ]
    }
  ],
