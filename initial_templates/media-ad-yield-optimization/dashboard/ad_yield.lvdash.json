{
  "datasets": [
    {
      "name": "weekly_kpi",
      "displayName": "Weekly yield KPIs",
      "queryLines": [
        "SELECT week_start,\n  SUM(revenue) AS revenue,\n  SUM(sold_impressions) / SUM(avails) AS sell_through,\n  1000 * SUM(revenue) / SUM(sold_impressions) AS ecpm,\n  1000 * SUM(CASE WHEN product_id = 'STR-SPORTS-LIVE' THEN programmatic_revenue ELSE 0 END)\n    / NULLIF(SUM(CASE WHEN product_id = 'STR-SPORTS-LIVE' THEN programmatic_impressions ELSE 0 END), 0) AS live_sports_ecpm\nFROM gold_inventory_daily\nWHERE week_start >= date_sub(date_trunc('WEEK', current_date()), 7 * 26)\nGROUP BY week_start HAVING COUNT(DISTINCT inventory_date) = 7\nORDER BY week_start"
      ]
    },
    {
      "name": "weekly_mix",
      "displayName": "Weekly revenue by channel",
      "queryLines": [
        "SELECT week_start, platform, channel, revenue FROM (\n  SELECT week_start, platform, SUM(guaranteed_revenue) AS g, SUM(pmp_revenue) AS p, SUM(open_auction_revenue) AS o\n  FROM gold_inventory_daily\n  WHERE week_start >= date_sub(date_trunc('WEEK', current_date()), 7 * 26) AND week_start < date_trunc('WEEK', current_date())\n  GROUP BY week_start, platform HAVING COUNT(DISTINCT inventory_date) = 7)\nLATERAL VIEW STACK(3, 'Guaranteed IOs', g, 'PMP deals', p, 'Open auction', o) s AS channel, revenue\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "ecpm_card",
      "displayName": "Programmatic eCPM vs rate card",
      "queryLines": [
        "SELECT product_name, measure, cpm FROM gold_yield_opportunities\n",
        "LATERAL VIEW STACK(3, 'Rate card', rate_card_cpm, 'Programmatic eCPM (28d)', programmatic_ecpm_28d, 'Open-auction clearing (28d)', open_clearing_cpm_28d) s AS measure, cpm\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "sports_weekly",
      "displayName": "Crest+ Live Sports weekly eCPM",
      "queryLines": [
        "SELECT week_start, measure, cpm FROM (\n  SELECT week_start,\n    1000 * SUM(programmatic_revenue) / NULLIF(SUM(programmatic_impressions), 0) AS prog,\n    1000 * SUM(open_auction_revenue) / NULLIF(SUM(open_auction_impressions), 0) AS open_c,\n    MAX(rate_card_cpm) AS rc\n  FROM gold_inventory_daily\n  WHERE product_id = 'STR-SPORTS-LIVE' AND week_start >= date_sub(date_trunc('WEEK', current_date()), 7 * 26) AND week_start < date_trunc('WEEK', current_date())\n  GROUP BY week_start HAVING COUNT(DISTINCT inventory_date) = 7)\nLATERAL VIEW STACK(3, 'Programmatic eCPM', prog, 'Open-auction clearing', open_c, 'Rate card', rc) s AS measure, cpm\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "sellthrough",
      "displayName": "Sell-through by platform x month",
      "queryLines": [
        "SELECT month_start, platform, SUM(sold_impressions) / SUM(avails) AS sell_through\n",
        "FROM gold_monthly_yield WHERE month_start >= add_months(date_trunc('MONTH', current_date()), -12)\n",
        "GROUP BY month_start, platform\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "opps",
      "displayName": "Yield opportunities",
      "queryLines": [
        "SELECT product_name, tier, rate_card_cpm, programmatic_ecpm_28d, open_clearing_cpm_28d, pmp_ecpm_28d,\n  current_inventory_group, rate_card_inventory_group, current_rule_id, current_rule_since,\n  CASE WHEN group_mismatch THEN 'MIS-PRICED' ELSE 'ok' END AS flag, CAST(ROUND(revenue_gap_28d) AS BIGINT) AS revenue_gap_28d, revenue_gap_since_rule\nFROM gold_yield_opportunities ORDER BY group_mismatch DESC, revenue_gap_28d DESC, programmatic_ecpm_28d / rate_card_cpm\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "kpi_pacing",
      "displayName": "Pacing KPIs",
      "queryLines": [
        "SELECT COUNT_IF(at_risk) AS at_risk_ios, COUNT_IF(status = 'Live') AS live_ios,\n",
        "  SUM(CASE WHEN at_risk THEN make_good_liability ELSE 0 END) AS make_good_liability,\n",
        "  SUM(CASE WHEN at_risk THEN projected_shortfall ELSE 0 END) AS projected_shortfall\n",
        "FROM gold_campaign_pacing WHERE status = 'Live'\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "pacing",
      "displayName": "Live campaign pacing",
      "queryLines": [
        "SELECT campaign_name, advertiser_name, io_number, target_segment,\n  CASE WHEN at_risk THEN 'AT RISK' ELSE 'on pace' END AS risk, pacing, projected_delivery_pct,\n  projected_shortfall, CAST(ROUND(make_good_liability) AS BIGINT) AS make_good_liability, risk_product_name, days_remaining\nFROM gold_campaign_pacing WHERE status = 'Live' ORDER BY at_risk DESC, make_good_liability DESC\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "liability",
      "displayName": "Make-good liability by campaign",
      "queryLines": [
        "SELECT advertiser_name AS advertiser, make_good_liability\nFROM gold_campaign_pacing WHERE at_risk\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "avails_fc",
      "displayName": "Avails actual vs ai_forecast",
      "queryLines": [
        "SELECT week_start, CASE product_id WHEN 'STR-SPORTS-LIVE' THEN 'Crest+ Live Sports' ELSE 'ACN Prime Drama' END || ' · ' || kind AS series, avails FROM (\n  SELECT product_id, week_start, SUM(avails) AS avails, 'actual' AS kind FROM gold_inventory_daily\n  WHERE product_id IN ('STR-SPORTS-LIVE', 'LIN-PRIME-DRAMA') AND week_start >= date_sub(date_trunc('WEEK', current_date()), 7 * 12)\n    AND week_start < date_trunc('WEEK', current_date())\n  GROUP BY product_id, week_start HAVING COUNT(DISTINCT inventory_date) = 7\n  UNION ALL\n  SELECT product_id, date_trunc('WEEK', forecast_date) AS week_start, SUM(avails_forecast) AS avails, 'forecast' AS kind FROM gold_avails_forecast\n  WHERE product_id IN ('STR-SPORTS-LIVE', 'LIN-PRIME-DRAMA') AND forecast_date >= date_trunc('WEEK', current_date())\n    AND forecast_date < date_add(date_trunc('WEEK', current_date()), 56)\n  GROUP BY product_id, date_trunc('WEEK', forecast_date))\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "mg_monthly",
      "displayName": "Make-goods issued by month",
      "queryLines": [
        "SELECT issued_month, SUM(make_good_value) AS make_good_value, COUNT(*) AS make_goods\n",
        "FROM gold_make_goods GROUP BY issued_month\n"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    },
    {
      "name": "spare",
      "displayName": "In-target spare avails, Auto Intenders, next 30 days",
      "queryLines": [
        "SELECT regexp_replace(s.product_name, ' [(].*[)]$', '') AS product_name, CAST(SUM(s.spare_avails * m.audience_share) AS BIGINT) AS in_target_spare\nFROM gold_spare_avails s JOIN product_audience_mix m ON m.product_id = s.product_id AND m.segment_id = 'AUTO-INT'\nWHERE s.forecast_date BETWEEN current_date() AND date_add(current_date(), 29)\nGROUP BY regexp_replace(s.product_name, ' [(].*[)]$', '')"
      ],
      "catalog": "media_advertising",
      "schema": "ad_yield_optimization"
    }
  ],
