{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Harlan headline KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS disrupted_pax,\n",
        "       AVG(CAST(autoprotect_same_day AS INT)) AS ap_same_day_rate,\n",
        "       SUM(CAST(special_assistance AND autoprotect_overnight AS INT)) AS ssr_overnight,\n",
        "       SUM(CAST(autoprotect_misconnect AS INT)) AS ap_misconnects,\n",
        "       SUM(CAST(desk_committed AS INT)) AS desk_rebooked,\n",
        "       AVG(CAST(current_same_day AS INT)) AS current_same_day_rate\n",
        "FROM v_harlan_pax_status\n"
      ]
    },
    {
      "name": "ds_flights",
      "displayName": "Harlan cancelled flights",
      "queryLines": [
        "SELECT flight_number, CONCAT(origin, ' → ', destination) AS route, pax, special_assistance_pax, umnr_pax, onward_long_haul_pax,\n",
        "       ap_same_day, ap_day_plus_2, ap_special_assistance_overnight, ap_misconnects, ap_split_party_pax, escalated_messages,\n",
        "       ap_special_assistance_overnight + ap_misconnects AS harm_score, COALESCE(eu_uk_261, 'US DOT') AS rights_regime\n",
        "FROM gold_harlan_flight_status\n"
      ]
    },
    {
      "name": "ds_outcome_mix",
      "displayName": "AutoProtect outcome mix by need",
      "queryLines": [
        "SELECT CASE WHEN unaccompanied_minor THEN 'Unaccompanied minors' WHEN special_assistance THEN 'Special assistance'\n",
        "  WHEN onward_long_haul THEN 'Onward long-haul' WHEN loyalty_tier IN ('Platinum','Diamond') THEN 'Platinum / Diamond' ELSE 'Everyone else' END AS passenger_group,\n",
        "  ROUND(100.0 * AVG(CASE WHEN autoprotect_same_day THEN 0 ELSE 1 END), 1) AS left_overnight_pct, COUNT(*) AS passengers\n",
        "FROM v_harlan_pax_status GROUP BY 1 ORDER BY left_overnight_pct DESC\n"
      ]
    },
    {
      "name": "ds_messages",
      "displayName": "Passenger messages (AI Functions)",
      "queryLines": [
        "SELECT CASE intent WHEN 'rebook_request' THEN 'Rebook request' WHEN 'refund_request' THEN 'Refund request' WHEN 'connection_at_risk' THEN 'Connection at risk' WHEN 'hotel_or_care' THEN 'Hotel or care' WHEN 'special_assistance' THEN 'Special assistance' WHEN 'baggage' THEN 'Baggage' WHEN 'complaint' THEN 'Complaint' WHEN 'praise' THEN 'Praise' ELSE intent END AS intent, CASE urgency WHEN 'urgent_life_event' THEN 'Urgent life event' WHEN 'vulnerable_passenger' THEN 'Vulnerable passenger' WHEN 'missed_onward_connection' THEN 'Missed onward connection' WHEN 'routine' THEN 'Routine' ELSE urgency END AS urgency, sentiment, COUNT(*) AS messages, SUM(CAST(escalate AS INT)) AS escalated\n",
        "FROM message_insights GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_recovery",
      "displayName": "Desk plans committed (write-back)",
      "queryLines": [
        "SELECT flight_number, destination, pax, ap_same_day,\n",
        "  CASE WHEN desk_same_day IS NULL THEN 'Not yet planned' ELSE CAST(desk_same_day AS STRING) END AS desk_same_day\n",
        "FROM v_harlan_recovery ORDER BY desk_plan_committed DESC, ap_special_assistance_overnight + ap_misconnects DESC\n"
      ]
    },
    {
      "name": "ds_decisions",
      "displayName": "Special-assistance passengers: AutoProtect vs desk (write-back)",
      "queryLines": [
        "SELECT flight_number, pnr, first_name || ' ' || last_name AS passenger, ssr_codes,\n",
        "  autoprotect_flight, CASE WHEN autoprotect_same_day THEN 'Today' WHEN autoprotect_nights = 1 THEN 'Tomorrow' ELSE 'Sunday' END AS autoprotect_when,\n",
        "  COALESCE(desk_flight, 'Not yet planned') AS desk_flight,\n",
        "  CASE WHEN desk_arrival IS NULL THEN 'Not yet planned' ELSE date_format(desk_arrival, 'EEE HH:mm') END AS desk_arrival,\n",
        "  CASE WHEN desk_committed AND desk_same_day THEN 'Today' WHEN desk_committed THEN 'Next day' ELSE 'Not yet planned' END AS desk_when\n",
        "FROM v_harlan_pax_status WHERE special_assistance\n",
        "ORDER BY desk_committed DESC, unaccompanied_minor DESC, flight_number\n"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "IROPS outcomes by month and handling method",
      "queryLines": [
        "SELECT CAST(month AS DATE) AS month, CASE handling_method WHEN 'AUTOPROTECT' THEN 'AutoProtect' ELSE 'DEN desk pilot' END AS handling_method, SUM(disrupted_pax) AS disrupted_pax,\n",
        "  SUM(same_day_rate * disrupted_pax) / SUM(disrupted_pax) AS same_day_rate,\n",
        "  SUM(cost_per_pax_usd * disrupted_pax) / SUM(disrupted_pax) AS cost_per_pax_usd,\n",
        "  SUM(misconnects) AS misconnects\n",
        "FROM gold_irops_monthly WHERE CAST(month AS DATE) < DATE'2026-02-01' GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_method",
      "displayName": "AutoProtect vs desk-priority pilot (since Dec 2025)",
      "queryLines": [
        "SELECT CASE handling_method WHEN 'AUTOPROTECT' THEN 'AutoProtect' ELSE 'DEN desk pilot' END AS handling,\n",
        "       COUNT(*) AS disrupted_pax,\n",
        "       AVG(CAST(same_day_reaccommodated AS INT)) AS same_day_rate,\n",
        "       SUM(CAST(misconnect AS INT)) / NULLIF(SUM(CAST(onward_long_haul AS INT)), 0) AS misconnect_rate,\n",
        "       AVG(total_cost_usd) AS cost_per_pax_usd,\n",
        "       100 * (AVG(CAST(promoter AS INT)) - AVG(CAST(detractor AS INT))) AS nps\n",
        "FROM irops_history WHERE event_date >= '2025-12-01' GROUP BY 1\n"
      ]
    },
    {
      "name": "ds_events",
      "displayName": "IROPS events",
      "queryLines": [
        "SELECT e.event_date, e.event_name, e.hub, e.cause_category, CASE e.handling_method WHEN 'AUTOPROTECT' THEN 'AutoProtect' ELSE 'DEN desk pilot' END AS handling_method, COUNT(h.history_pax_id) AS disrupted_pax,\n",
        "       AVG(CAST(h.same_day_reaccommodated AS INT)) AS same_day_rate, AVG(h.total_cost_usd) AS cost_per_pax_usd,\n",
        "       100 * (AVG(CAST(h.promoter AS INT)) - AVG(CAST(h.detractor AS INT))) AS nps\n",
        "FROM irops_events e JOIN irops_history h ON h.event_id = e.event_id GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_harm_top",
      "displayName": "Harm Top",
      "queryLines": [
        "SELECT flight_number, ap_special_assistance_overnight + ap_misconnects AS harm_score\n",
        "FROM gold_harlan_flight_status ORDER BY harm_score DESC LIMIT 12\n"
      ],
      "catalog": "retail_consumer_goods",
      "schema": "travel_disruption_rebooking"
    }
  ],
