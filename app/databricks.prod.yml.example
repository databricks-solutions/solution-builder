# ============================================================================
# Per-deployment configuration for the `prod` target.
# ============================================================================
# Copy this file to `databricks.prod.yml` (gitignored) and fill in the three
# sections below. The bundle CLI auto-includes any `databricks.*.yml` next to
# `databricks.yml` (see the `include:` directive there).
#
# Deploy:  databricks bundle deploy
# (No -t flag needed — `prod` is the only target and is marked default.)
# ============================================================================

targets:
  prod:
    # ────────────────────────────────────────────────────────────────────────
    # Section 1 — workspace profile
    # ────────────────────────────────────────────────────────────────────────
    # The ~/.databrickscfg profile to deploy with. Set it up once with:
    #   databricks auth login --host <workspace-url> --profile <name>
    workspace:
      profile: <your-prod-profile>

    # ────────────────────────────────────────────────────────────────────────
    # Section 2 — bundle variables
    # ────────────────────────────────────────────────────────────────────────
    # Resource identifiers used by `databricks.yml` to grant the app's SP
    # access. Each must already exist in the target workspace.
    variables:
      app_name: <your-prod-app-name>
      # Lakebase autoscaling project — split into 3 vars so the bundle can
      # manage project/branch as first-class resources, and we compose the
      # full path for the running container's LAKEBASE_DATABASE_PATH env var.
      # Find these in the Lakebase UI URL: /lakebase/projects/<project-id>?branchId=<branch-id>&database=<db>
      # The DB must exist (one-time `CREATE DATABASE <db>;` per fresh env).
      lakebase_project_id: <your-project-id>
      lakebase_branch_id: <your-branch-id>
      lakebase_database_name: <your-db-name>
      # anthropic_llm_endpoint + anthropic_base_path MUST match (they name an
      # endpoint AND the shim that resolves it):
      #   serving-endpoints/anthropic → FMAPI default Anthropic bridge. Use a
      #       built-in name, e.g. `databricks-claude-sonnet-4-8`.
      #   ai-gateway/anthropic        → AI Gateway Anthropic shim. Use your
      #       custom AI Gateway endpoint name, e.g. `demo-generator-do-not-delete`.
      anthropic_llm_endpoint: databricks-claude-sonnet-4-8
      anthropic_base_path: serving-endpoints/anthropic
      ai_gateway: databricks-claude-opus-4-7
      ai_gateway_mini: databricks-gpt-5-4-mini
      ai_gateway_embedding: databricks-qwen3-embedding-0-6b
      # Unity Catalog every new project lands in. Created at app boot if
      # missing; USE CATALOG + CREATE SCHEMA granted to `account users`,
      # ALL PRIVILEGES granted to each admin in template_admin_emails.
      default_catalog: ai_demo_gen

      # ──────────────────────────────────────────────────────────────────────
      # Section 3 — runtime environment
      # ──────────────────────────────────────────────────────────────────────
      # `build.sh` copies this dict 1:1 into `.build/app.yml`'s `env:` block.
      # Add a new line here and it appears as a container env var on the next
      # `databricks bundle deploy`. No other file needs editing.
      app_env:
        LAKEBASE_DATABASE_PATH: projects/${var.lakebase_project_id}/branches/${var.lakebase_branch_id}/databases/${var.lakebase_database_name}
        ANTHROPIC_LLM_ENDPOINT: ${var.anthropic_llm_endpoint}
        ANTHROPIC_BASE_PATH: ${var.anthropic_base_path}
        AI_GATEWAY: ${var.ai_gateway}
        AI_GATEWAY_MINI: ${var.ai_gateway_mini}
        AI_GATEWAY_EMBEDDING: ${var.ai_gateway_embedding}
        DEFAULT_CATALOG: ${var.default_catalog}
