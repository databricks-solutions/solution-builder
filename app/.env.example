# =============================================================================
# Databricks Asset Generator - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL for local development
# The app requires a PostgreSQL database for storing projects, messages, etc.
LAKEBASE_PG_URL=postgresql://user:password@localhost:5432/demo_prompt_generator

# -----------------------------------------------------------------------------
# Databricks Authentication (choose ONE method)
# -----------------------------------------------------------------------------
# The app uses the Databricks Python SDK unified authentication.
# Authentication is checked in this order:
#
# 1. PROFILE-BASED (recommended for local dev):
#    Set DATABRICKS_CONFIG_PROFILE to use a profile from ~/.databrickscfg
#    First run: databricks auth login --host <workspace-url> --profile <name>
DATABRICKS_CONFIG_PROFILE=DEFAULT

# 2. DIRECT TOKEN AUTH:
#    Set host and token directly (useful for CI/CD or if you don't want profiles)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Model endpoint for the Claude Code agent (must exist in your workspace)
DEMO_PROMPT_GENERATOR_LLM_MODEL=databricks-claude-sonnet-4

# AI Gateway model names (SDK handles auth + routing via serving_endpoints.get_open_ai_client())
AI_GATEWAY_MINI=databricks-gpt-5-4-mini
AI_GATEWAY=databricks-claude-opus-4-7
AI_GATEWAY_EMBEDDING=databricks-qwen3-embedding-0-6b

# -----------------------------------------------------------------------------
# AI Dev Kit Configuration
# -----------------------------------------------------------------------------
# Branch to use for ai-dev-kit skills repository
# IMPORTANT: Using 'add-aidevkit-cli' branch which removes MCP in favor of CLI tools
# TODO: Change back to 'main' once this branch is merged
AI_DEV_KIT_BRANCH=add-aidevkit-cli
