# Databricks workspace credentials for LLM calls
DEMO_PROMPT_GENERATOR_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DEMO_PROMPT_GENERATOR_DATABRICKS_TOKEN=dapi...
DEMO_PROMPT_GENERATOR_LLM_MODEL=databricks-claude-sonnet-4

# Local database config (managed by APX dev server)
PGAPPNAME=demo-prompt-generator
DATABRICKS_CONFIG_PROFILE=DEFAULT

# AI Dev Kit repository configuration
AI_DEV_KIT_BRANCH=main
