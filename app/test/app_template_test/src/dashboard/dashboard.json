          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# LuxeBeauty Returns \u2014 Operations\n\nClaire Dubois, VP Ops. The bad lot LOT-2026-0427 ships in late April, the surge follows weeks later. We've traced it; this dashboard tracks the recovery."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_refunds",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "weekly(date)",
                      "expression": "DATE_TRUNC(\"WEEK\", `date`)"
                    },
                    {
                      "name": "sum(returns_usd)",
                      "expression": "SUM(`returns_usd`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(returns_usd)",
                  "displayName": "Refunds (90d)",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "period": {
                  "fieldName": "weekly(date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Refunds \u2014 last 90d"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
