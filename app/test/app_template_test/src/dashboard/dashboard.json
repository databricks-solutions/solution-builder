{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Daily summary",
      "queryLines": [
        "SELECT date, region, category, order_count, return_count, revenue_usd, returns_usd FROM gold_daily_summary WHERE date >= DATEADD(day, -90, current_date())"
      ],
      "catalog": "ai_demo_gen",
      "schema": "demo_luxebeauty_test"
    },
    {
      "name": "ds_returns",
      "displayName": "Returns (last 90 days, per-row)",
      "queryLines": [
        "SELECT return_id, return_date, country, city, customer_lat, customer_lng, region, product_name, category, lot_id, facility, is_bad_lot, CASE WHEN is_bad_lot THEN 'Affected lot' ELSE 'Everyday returns' END AS source, return_reason, customer_comment, anger_score, CASE WHEN anger_score >= 0.9 THEN '3 - Very angry' WHEN anger_score >= 0.5 THEN '2 - Angry' WHEN anger_score >= 0.2 THEN '1 - Neutral' ELSE '0 - Satisfied' END AS sentiment, refund_amount_usd FROM silver_returns WHERE return_date >= DATEADD(day, -90, current_date())"
      ],
      "catalog": "ai_demo_gen",
      "schema": "demo_luxebeauty_test"
    },
    {
      "name": "ds_forecast",
      "displayName": "Weekly refunds \u2014 actuals + forecast",
      "queryLines": [
        "WITH original AS (SELECT DATE_TRUNC('WEEK', date) AS week, SUM(returns_usd) AS refunds FROM gold_daily_summary WHERE DATE_TRUNC('WEEK', date) < DATE_TRUNC('WEEK', current_date()) AND date >= DATEADD(day, -180, current_date()) GROUP BY 1), dates AS (SELECT MAX(week) AS max_w FROM original), forecast AS (SELECT week, refunds_forecast, refunds_upper, refunds_lower FROM AI_FORECAST(TABLE(original), horizon => (SELECT max_w + INTERVAL 28 DAYS FROM dates), time_col => 'week', value_col => 'refunds')), actuals AS (SELECT week, CAST(NULL AS DOUBLE) AS refunds_forecast, CAST(NULL AS DOUBLE) AS refunds_upper, CAST(NULL AS DOUBLE) AS refunds_lower, refunds FROM original), forecast_aligned AS (SELECT week, refunds_forecast, refunds_upper, refunds_lower, CAST(NULL AS DOUBLE) AS refunds FROM forecast) SELECT week, refunds_forecast, refunds_upper, refunds_lower, refunds FROM actuals UNION ALL SELECT week, refunds_forecast, refunds_upper, refunds_lower, refunds FROM forecast_aligned UNION ALL SELECT (SELECT max_w FROM dates) AS week, refunds AS refunds_forecast, refunds AS refunds_upper, refunds AS refunds_lower, CAST(NULL AS DOUBLE) AS refunds FROM original WHERE week = (SELECT max_w FROM dates)"
      ],
      "catalog": "ai_demo_gen",
      "schema": "demo_luxebeauty_test"
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Operations",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# LuxeBeauty Returns \u2014 Operations",
                "",
                "**The story**: weekly refunds spiked to ~$180K three weeks ago \u2014 3\u00d7 our $60K baseline. Cause: production lot **LOT-2026-0427** of three Skincare SKUs (SKU-1001/1002/1003) was released from Lyon despite a QC note about texture variations. ~250 customers affected, concentrated in EU markets (Paris, London, Milan).",
                "",
                "**What to see on this page**: KPI sparklines (top) carry the spike-then-decay shape \u00b7 the forecast-line marks the production-incident date as an orange vertical bar to the LEFT of the bump (cause \u2192 effect \u2192 4-week recovery forecast) \u00b7 the donut shows Skincare dominates refunds \u00b7 the bubble map lights up Europe with Paris as the deepest red dot."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "kpi_refunds",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "weekly(date)",
                      "expression": "DATE_TRUNC(\"WEEK\", `date`)"
                    },
                    {
                      "name": "sum(returns_usd)",
                      "expression": "SUM(`returns_usd`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(returns_usd)",
                  "displayName": "Refunds (90d)",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  },
                  "color": {
                    "hex": "#094074"
                  }
                },
                "period": {
                  "fieldName": "weekly(date)",
                  "color": {
                    "hex": "#094074"
                  },
                  "style": {
                    "areaFill": true,
                    "fillOpacity": 0.25
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Refunds \u2014 last 90d"
