{
  // App config (JSONC). Loaded by server/server.ts loadAppConfig.
  // ${VAR} / ${VAR:default} placeholders are substituted against process.env
  // BEFORE JSON parsing. Empty values → field falls back to optional
  // (the agent gracefully degrades; see warnings in server.ts).
  //
  // Source-of-truth for env: databricks.yml apps.luxebeauty_demo.env (bundle
  // deploy) or .env (local dev).

  // ─ Agent backend ─────────────────────────────────────────────────────
  // masEndpointName populated by the bundle from the deploy_mas task value.
  // genieSpaceId only used when the demo bypasses MAS and talks to Genie
  // directly (set MAS to "" + set Genie to wire the askGenieTool).
  "masEndpointName": "${MAS_ENDPOINT_NAME:}",
  "genieSpaceId":    "${GENIE_SPACE_ID:}",

  // Agent LLM. MUST be databricks-gpt-5-4 (only Databricks model with
  // openai/v1/responses enabled — others 400 BAD_REQUEST).
  "agentModel": "databricks-gpt-5-4",

  // MLflow trace path. Auto-created at boot via lib/mlflow.ts.
  "mlflowExperimentId": "",
  "agentMlflowExperimentPath": "${AGENT_MLFLOW_EXPERIMENT_PATH:}",

  // Embedded AI/BI dashboard. Resolved from the DAB dashboard resource.
  "dashboardId": "${DASHBOARD_ID:}",

  // Workspace resource IDs → composed into deep-link URLs by /api/resources
  // (PlatformDiagram on /platform). Empty id → tile renders inert.
  "pipelineId":        "${PIPELINE_ID:}",
  "warehouseId":       "${WAREHOUSE_ID:}",
  "kaEndpointName":    "${KA_ENDPOINT_NAME:}",
  "lakebaseProjectId": "${LAKEBASE_PROJECT_ID:}",
  "appUrl":            "${APP_URL:}",
  "mlModelName":       "${DEMO_CATALOG}.${DEMO_SCHEMA}.customer_premium_classifier",
  "pdfVolumePath":     "/Volumes/${DEMO_CATALOG}/${DEMO_SCHEMA}/manufacturing_reports",

  // Delta source for boot-time Lakebase mirror (server/db/sync.ts).
  "data": {
    "catalog": "${DEMO_CATALOG}",
    "schema":  "${DEMO_SCHEMA}",
    "tables": {
      "returns":         "silver_returns",
      "orders":          "silver_orders",
      "customers":       "raw_customers",
      "customerPremium": "gold_customer_premium_predictions"
    }
  },

  "branding": {
    "appName": "LuxeBeauty Returns Console"
  },

  "assistantScript": [
    {
      "prompt": "Why do I have so many returns?"
    },
    {
      "prompt": "Handle these affected customers. Use the premium classifier to pick who gets the bigger save — draft a 20% personal apology for premium customers (CS-tagged plus the ones the model finds) and a 5% goodwill for the rest. Show me both before sending.",
      "triggerAfter": ["lot", "batch", "customers"]
    },
    {
      "prompt": "Yes — send both and approve all the refunds.",
      "triggerAfter": ["tier", "premium", "coupon"]
    }
  ]
}
