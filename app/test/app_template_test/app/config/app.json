{
  // App config (JSONC). Loaded by server/server.ts loadAppConfig.
  // Exposed: /api/config (branding/script/dashboard) + /api/resources (deep-links).
  // Fields are ordered by deploy sequence — fill top→bottom as resources land.
  // Restart the dev server after edits (config is read once at boot).

  // ─ Agent backend: set ONE. masEndpointName → ask_mas tool registered.
  //   genieSpaceId → swap to askGenieTool in server/agent/refundops.ts makeTools.
  //   Empty both → no data tool → agent can't answer "why" questions.
  "masEndpointName": "mas-9d253a6f-endpoint",
  "genieSpaceId": "",

  // Agent LLM. MUST be databricks-gpt-5-4 (only Databricks model with
  // openai/v1/responses enabled — others 400 BAD_REQUEST). Don't change.
  "agentModel": "databricks-gpt-5-4",

  // MLflow trace path. Empty → chat shows "Trace pending…" forever.
  // Auto-created at boot via lib/mlflow.ts. Format: /Users/<email>/<app>-traces.
  "mlflowExperimentId": "",
  "agentMlflowExperimentPath": "/Users/quentin.ambard@databricks.com/luxebeauty_demo/luxebeauty-demo-app-agent-traces",

  // Embedded AI/BI dashboard (UUID). Empty → drop the /dashboard route +
  // sidebar entry (App.tsx + shell/AppHeader.tsx). Also tile on /platform.
  "dashboardId": "01f165c28bfd13a79fb66a71c49d56ca",

  // Workspace resource IDs → composed into deep-link URLs by /api/resources
  // (PlatformDiagram on /platform). Empty id → tile renders inert.
  // Fill in after each resource is deployed.
  "pipelineId": "6899b481-76df-47cc-bb0e-5311bbbd22d7",                            // Lakeflow SDP pipeline UUID
  "warehouseId": "75fd8278393d07eb",                                               // SQL warehouse id (hex)
  "kaEndpointName": "ka-6e89d700-endpoint",                                        // Knowledge Assistant endpoint (ka-<id>-endpoint)
  "lakebaseProjectId": "8423d8ac-55d8-4761-aeed-8668fbbfa2d2",                     // Lakebase project UUID
  "appUrl": "https://sln-builder-luxebeauty-demo-2556758628403379.aws.databricksapps.com", // This app's deployed URL (different host)
  "mlModelName": "retail_consumer_goods.luxebeauty_demo.customer_premium_classifier", // 3-part UC name: catalog.schema.model
  "pdfVolumePath": "/Volumes/retail_consumer_goods/luxebeauty_demo/manufacturing_reports", // /Volumes/<catalog>/<schema>/<volume>

  // Delta source for boot-time Lakebase mirror (server/db/sync.ts).
  // Table names map to TS types in client/src/shared/types.ts + Drizzle
  // schema in server/db/schema.ts — change all three together.
  // customerPremium: empty → skip ML predictions sync.
  "data": {
    "catalog": "retail_consumer_goods",
    "schema": "luxebeauty_demo",
    "tables": {
      "returns": "silver_returns",
      "orders": "silver_orders",
      "customers": "raw_customers",
      "customerPremium": "gold_customer_premium_predictions"
    }
  },

  // Surfaces in dock header + page titles.
  "branding": {
    "appName": "LuxeBeauty Returns Console"
  },

  // Dock's "Suggested next" chip walks this list. Step N unlocks once the
  // previous assistant message contains any triggerAfter[] substring.
  // Picker: client/src/chat/script.ts.
  "assistantScript": [
    {
      "prompt": "Why do I have so many returns?"
    },
    {
      "prompt": "Handle these affected customers. Use the premium classifier to pick who gets the bigger save — draft a 20% personal apology for premium customers (CS-tagged plus the ones the model finds) and a 5% goodwill for the rest. Show me both before sending.",
      "triggerAfter": ["lot", "batch", "customers"]
    },
    {
      "prompt": "Yes — send both and approve all the refunds.",
      "triggerAfter": ["tier", "premium", "coupon"]
    }
  ]
}
