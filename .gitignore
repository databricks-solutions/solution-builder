.DS_Store
.env
.env.local
.env.*
!.env.example

# IDE and tool config -- each user configures their own
.mcp.json
.cursor/
.claude/*
!.claude/skills/
!.claude/commands/
app/.claude/
*.code-workspace

# Locally-installed Databricks AI Dev Kit skill packs (per-user; not part of this repo)
.github/skills/

# ai-dev-kit (installed locally per user)
.ai-dev-kit/


# Node / test tooling (root-level, used for local Playwright testing)
node_modules/
package.json
package-lock.json
bun.lockb

# …but the demo-generator's app_template/ ships package.json + lockfile
# as part of the template — those files are content, not noise.
!.claude/skills/databricks-solution-builder/app/app_template/package.json
!.claude/skills/databricks-solution-builder/app/app_template/package-lock.json

# Same exception for the test app — the bundle CLI honors .gitignore at
# the repo root when packaging the app source, so without these un-ignore
# rules the Apps platform receives no dependencies file and the container
# crashes with `ERR_MODULE_NOT_FOUND` at boot.
!app/test/app_template_test/app/package.json
!app/test/app_template_test/app/package-lock.json

# Playwright artifacts
playwright-report/
test-results/
screenshot-eval/

# tests/pipeline/ harness output
test-runs/

# Python caches
__pycache__/
*.pyc

# Local scratch space (screenshots, throwaway scripts, etc.)
.scratch/

# Generator app's vendored internal pages — symlinked/copied from ../dbrain/docs/
# (pitch, vision, shift-left). Internal only: served by the app if present,
# packaged into the build if present, never committed to this public repo.
app/src/demo_prompt_generator/ui/public/the_vision/
app/src/demo_prompt_generator/ui/public/pitch
app/src/demo_prompt_generator/ui/public/shift-left

# Internal FE ops tool — not part of the public repo (kept locally)
add_team_to_workspace.py

# Internal vibe-marketplace sync helper — kept local, not for the public repo
scripts/publish-skill-to-vibe.sh

# Internal vibe working notes / overlap audit — local scratch, not for the public repo
.vibe-work-notes.md
.vibe-overlap-diffs.md

# Build/state junk inside seed template folders (regenerates on deploy — never commit)
initial_templates/**/.databricks/
initial_templates/**/node_modules/
initial_templates/**/dist/
initial_templates/**/client/dist/
initial_templates/**/.env
initial_templates/**/.env.*
initial_templates/**/.DS_Store
initial_templates/**/.venv/
