.DS_Store
.env
.env.local
.env.*
!.env.example

# IDE and tool config -- each user configures their own
.mcp.json
.cursor/
.claude/*
!.claude/skills/
!.claude/commands/
app/.claude/
*.code-workspace

# ai-dev-kit (installed locally per user)
.ai-dev-kit/


# Node / test tooling (root-level, used for local Playwright testing)
node_modules/
package.json
package-lock.json
bun.lockb

# …but the demo-generator's app_template/ ships package.json + lockfile
# as part of the template — those files are content, not noise.
!.claude/skills/databricks-demo-generator/app/app_template/package.json
!.claude/skills/databricks-demo-generator/app/app_template/package-lock.json

# Playwright artifacts
playwright-report/
test-results/
screenshot-eval/

# tests/pipeline/ harness output
test-runs/

# Python caches
__pycache__/
*.pyc

# Local scratch space (screenshots, throwaway scripts, etc.)
.scratch/
